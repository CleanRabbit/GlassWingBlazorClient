@* Task 39 — inline buy-something picker rendered for each empty home-accessory slot, mirroring
   Task 37's EmptyCageSlotCard for cage slots. Accessories are heterogeneous (5 different shapes),
   so this needs a kind dropdown first, then (for Weather/Medication, which have more than one
   purchasable type) a second type dropdown. *@
@inject GlassWingApiClient Api

<div class="card h-100 border-secondary" style="border-style:dashed">
    <div class="card-body d-flex flex-column align-items-center justify-content-center text-center py-4">
        <div class="text-muted mb-2">Empty accessory slot</div>
        <select class="form-select form-select-sm mb-2" style="max-width:220px"
                value="@selectedKind" @onchange="e => { selectedKind = e.Value?.ToString() ?? string.Empty; selectedTypeId = string.Empty; }">
            <option value="">— choose a kind —</option>
            <option value="CarryCase">Carry Case</option>
            <option value="StorageDrawers">Storage Drawers</option>
            <option value="FoodStorageBin">Food Storage Bin</option>
            <option value="WeatherAccessory">Weather Accessory</option>
            <option value="MedicationDevice">Medication Device</option>
        </select>

        @if (selectedKind is "WeatherAccessory" or "MedicationDevice")
        {
            <select class="form-select form-select-sm mb-2" style="max-width:220px" @bind="selectedTypeId">
                <option value="">— choose a type —</option>
                @foreach (var (id, label) in TypeOptions)
                {
                    <option value="@id">@label</option>
                }
            </select>
        }
        else if (!string.IsNullOrEmpty(selectedKind) && SinglePrice is { } price)
        {
            <div class="small text-muted mb-2">@price cr</div>
        }

        @if (error is not null)
        {
            <div class="text-danger small mb-2">@error</div>
        }
        <button class="btn btn-sm btn-outline-primary"
                disabled="@(!CanBuy || busy)"
                @onclick="BuyAsync">
            @(busy ? "..." : "Buy")
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public int AnchorIndex { get; set; }
    [Parameter] public ShopCatalogueResponse? Catalogue { get; set; }
    [Parameter] public EventCallback<decimal> OnPurchased { get; set; }

    string selectedKind = string.Empty;
    string selectedTypeId = string.Empty;
    bool busy;
    string? error;

    (string Id, string Label)[] TypeOptions => selectedKind switch
    {
        "WeatherAccessory" => (Catalogue?.WeatherAccessories ?? [])
            .Select(t => (t.Id, $"{t.Name} ({t.InGamePrice} cr)")).ToArray(),
        "MedicationDevice" => (Catalogue?.Medications ?? [])
            .Where(m => m.DeliveryType == "HomeAccessoryDevice")
            .Select(t => (t.Id, $"{t.Name} ({t.InGamePrice} cr)")).ToArray(),
        _ => []
    };

    int? SinglePrice => selectedKind switch
    {
        "CarryCase"      => Catalogue?.CarryCases?.FirstOrDefault()?.InGamePrice,
        "StorageDrawers" => Catalogue?.StorageDrawers?.FirstOrDefault()?.InGamePrice,
        "FoodStorageBin" => Catalogue?.FoodStorageBins.FirstOrDefault()?.InGamePrice,
        _                => null
    };

    bool RequiresType => selectedKind is "WeatherAccessory" or "MedicationDevice";

    bool CanBuy => !string.IsNullOrEmpty(selectedKind) && (!RequiresType || !string.IsNullOrEmpty(selectedTypeId));

    async Task BuyAsync()
    {
        if (!CanBuy) return;
        busy = true;
        error = null;

        bool success;
        string? err;
        decimal newBalance = 0;
        switch (selectedKind)
        {
            case "CarryCase":
            {
                var (result, e) = await Api.BuyCarryCaseAsync(AnchorIndex);
                success = result is not null; err = e; if (result is not null) newBalance = result.NewBalance;
                break;
            }
            case "StorageDrawers":
            {
                var (result, e) = await Api.BuyStorageDrawersAsync(AnchorIndex);
                success = result is not null; err = e; if (result is not null) newBalance = result.NewBalance;
                break;
            }
            case "FoodStorageBin":
            {
                var (result, e) = await Api.BuyFoodStorageBinAsync(AnchorIndex);
                success = result is not null; err = e; if (result is not null) newBalance = result.NewBalance;
                break;
            }
            case "WeatherAccessory":
            {
                var (result, e) = await Api.BuyWeatherAccessoryAsync(selectedTypeId, AnchorIndex);
                success = result is not null; err = e; if (result is not null) newBalance = result.NewBalance;
                break;
            }
            case "MedicationDevice":
            {
                var (result, e) = await Api.BuyMedicationDeviceAsync(selectedTypeId, AnchorIndex);
                success = result is not null; err = e; if (result is not null) newBalance = result.NewBalance;
                break;
            }
            default:
                success = false; err = "Choose a kind.";
                break;
        }

        if (success)
        {
            selectedKind = string.Empty;
            selectedTypeId = string.Empty;
            await OnPurchased.InvokeAsync(newBalance);
        }
        else
        {
            error = err ?? "Failed to buy.";
        }
        busy = false;
    }
}
