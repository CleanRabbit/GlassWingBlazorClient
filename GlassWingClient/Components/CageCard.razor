    // A cage replacement's CagePurchaseResponse is deliberately sparse (no Type/Food/Rats/etc.) —
    // same reasoning as buying into a fresh empty slot — so the parent reloads the whole home
    // rather than trying to patch this card in place.
    async Task ConfirmReplaceAsync()
    {
        if (string.IsNullOrEmpty(replaceTypeId)) return;
        replaceBusy = true;
        replaceError = null;
        var (result, err) = await Api.BuyCageAsync(replaceTypeId, SlotIndex);
        if (result is not null)
        {
            replacingCage = false;
            await OnCageReplaced.InvokeAsync(result);
        }
        else
        {
            replaceError = err ?? "Failed to replace cage.";
        }
        replaceBusy = false;
    }

    void StartMove(string ratId)
    {
        movingRatId = ratId;
        moveTargetCageId = string.Empty;
        moveError = null;
    }

    // Pickup + place composition (same two-hop primitive WelfareLockOverlay.razor's
    // MergeCagesAsync already uses) — re-fetches home locally to find the carry case the pickup
    // just created, since neither call returns one directly.
    async Task ConfirmMoveAsync(string ratId)
    {
        if (string.IsNullOrEmpty(moveTargetCageId)) return;
        moveBusy = true;
        moveError = null;

        var (pickedUp, pickupErr) = await Api.PickUpRatFromCageAsync(Cage.Id, ratId);
        if (!pickedUp)
        {
            moveError = pickupErr ?? "Failed to pick up rat.";
            moveBusy = false;
            return;
        }

        var (freshHome, _) = await Api.GetHomeAsync();
        var carryCase = freshHome?.CarryCases?.FirstOrDefault(c => c.RatId == ratId);
        if (carryCase is null)
        {
            moveError = "Rat picked up but no carry case found — refresh and try again.";
            moveBusy = false;
            return;
        }

        var (placed, placeErr) = await Api.PlaceRatFromCarryCaseAsync(carryCase.Id, moveTargetCageId);
        if (!placed)
        {
            moveError = placeErr ?? "Failed to place rat in the target cage.";
            moveBusy = false;
            return;
        }

        movingRatId = null;
        moveTargetCageId = string.Empty;
        moveBusy = false;
        await OnHomeChanged.InvokeAsync();
    }

    async Task SetCageCosmeticAsync(string? cosmeticId)
    {
        cosmeticBusy = true;
        cosmeticError = null;
        var (cage, err) = await Api.SetCageCosmeticAsync(Cage.Id, string.IsNullOrEmpty(cosmeticId) ? null : cosmeticId);
        if (cage is not null)
        {
            await OnCageUpdated.InvokeAsync(cage);
        }
        else
        {
            cosmeticError = err ?? "Failed to update decoration.";
        }
        cosmeticBusy = false;
    }

    static string BarClass(int level) => level switch
    {
        >= 60 => "bg-success",
        >= 30 => "bg-warning",
        _     => "bg-danger"
    };

    static string ConditionBadgeClass(double condition) => condition switch
    {
        >= 60 => "bg-secondary",
        >= 30 => "bg-warning text-dark",
        _     => "bg-danger"
    };

    static string TierBadgeClass(string? tier) => tier switch
    {
        "Starter" => "bg-secondary",
        "Budget"  => "bg-info text-dark",
        "Mid"     => "bg-info text-dark",
        "Large"   => "bg-primary",
        "Premium" => "bg-warning text-dark",
        "Bespoke" => "bg-danger",
        _         => "bg-secondary"
    };

    static string LifeStageBadgeClass(string lifeStage) =>
        lifeStage == "Weening" ? "bg-danger-subtle text-danger-emphasis border border-danger-subtle" : "bg-secondary";

    static string LifeStageAbbreviation(string lifeStage) => lifeStage switch
    {
        "Infant"   => "Inf",
        "Juvenile" => "Juv",
        _          => ""
    };

    static string EfficacyClass(double v) =>
        v >= 1.5 ? "text-success" : v > 0 ? "text-muted" : "text-muted opacity-50";
}
