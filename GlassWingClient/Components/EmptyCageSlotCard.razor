@* Task 37 — inline buy-a-cage picker rendered for each empty cage slot on the Home page, so a
   player never has to leave /home to fill a newly-opened slot after an Estate Agency upgrade. *@
@inject GlassWingApiClient Api

<div class="card h-100 border-secondary" style="border-style:dashed">
    <div class="card-body d-flex flex-column align-items-center justify-content-center text-center py-4">
        <div class="text-muted mb-2">Empty cage slot</div>
        <select class="form-select form-select-sm mb-2" style="max-width:220px" @bind="selectedTypeId">
            <option value="">— choose a cage —</option>
            @foreach (var type in AvailableCageTypes)
            {
                <option value="@type.Id">@type.Brand @type.ModelName (@type.Price cr)</option>
            }
        </select>
        @if (error is not null)
        {
            <div class="text-danger small mb-2">@error</div>
        }
        <button class="btn btn-sm btn-outline-primary"
                disabled="@(string.IsNullOrEmpty(selectedTypeId) || busy)"
                @onclick="BuyAsync">
            @(busy ? "..." : "Buy Cage")
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public int SlotIndex { get; set; }
    [Parameter, EditorRequired] public ShopCageType[] CageTypes { get; set; } = [];
    [Parameter] public string? MaxCageTier { get; set; }
    [Parameter] public EventCallback<CagePurchaseResponse> OnCagePurchased { get; set; }

    string selectedTypeId = string.Empty;
    bool busy;
    string? error;

    // Mirrors the backend's CageTier enum order (GlassWing.Application.Features.PlayerHome.Models.CageType).
    static readonly string[] TierOrder = ["Starter", "Budget", "Mid", "Large", "Premium", "Bespoke"];

    ShopCageType[] AvailableCageTypes
    {
        get
        {
            var maxRank = MaxCageTier is null ? TierOrder.Length - 1 : Array.IndexOf(TierOrder, MaxCageTier);
            return CageTypes
                .Where(t => t.Tier is null || Array.IndexOf(TierOrder, t.Tier) <= maxRank)
                .OrderBy(t => t.Price)
                .ToArray();
        }
    }

    async Task BuyAsync()
    {
        if (string.IsNullOrEmpty(selectedTypeId)) return;
        busy = true;
        error = null;
        var (result, err) = await Api.BuyCageAsync(selectedTypeId, SlotIndex);
        if (result is not null)
        {
            selectedTypeId = string.Empty;
            await OnCagePurchased.InvokeAsync(result);
        }
        else
        {
            error = err ?? "Failed to buy cage.";
        }
        busy = false;
    }
}
