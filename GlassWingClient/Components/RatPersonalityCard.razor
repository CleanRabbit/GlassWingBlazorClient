@* Task 32 §4 — extracted from Pages/RatDetail.razor's inline "Personality" card. Purely
   presentational — no interactive elements. *@

<div class="card h-100">
    <div class="card-body">
        <h6 class="card-subtitle mb-3 text-muted">Personality</h6>
        @if (Traits is { Length: > 0 })
        {
            <div class="d-flex flex-wrap gap-2">
                @foreach (var trait in Traits)
                {
                    <span class="badge bg-secondary" title="@TraitDescription(trait)">@trait</span>
                }
            </div>
        }
        else
        {
            <span class="text-muted small">No notable traits</span>
        }
    </div>
</div>

@code {
    [Parameter] public string[]? Traits { get; set; }

    public static string TraitDescription(string trait) => trait switch
    {
        "Fussy"         => "Picky about food quality.",
        "Overweight"    => "Carrying extra weight.",
        "Bold"          => "Fearless and quick to try new things. Slightly boosts event scores. Fixed from birth.",
        "Shy"           => "Cautious and easily startled. Slightly hurts event scores. Fixed from birth.",
        "Curious"       => "Investigates its surroundings eagerly. Slightly speeds up training. Fixed from birth.",
        "Lazy"          => "Hasn't been engaged in play recently. Slightly slows training.",
        "Playful"       => "Consistently engaged in play lately. Slightly speeds up training.",
        "Affectionate"  => "Deeply bonded with its owner. Slightly speeds up further bonding gains.",
        "Foodie"        => "Motivated by treats. Slightly speeds up training. Fixed from birth.",
        "Gregarious"    => "Highly social with other rats. Slightly speeds up bonding gains. Fixed from birth.",
        "Independent"   => "Confident but doesn't seek out attention. Slightly boosts event scores. Fixed from birth.",
        "Popcorn"       => "Energetic and athletic. Slightly boosts event scores. Fixed from birth.",
        "Sleepy"        => "Low energy. Slightly hurts event scores. Fixed from birth.",
        "Homebody"      => "Calm in familiar surroundings. Slightly slows stress buildup. Fixed from birth.",
        "Driven"        => "Motivated to improve. Slightly speeds up training. Fixed from birth.",
        "Snappy"        => "On edge from recent stress. Slightly speeds up further stress buildup.",
        "DevotedMother" => "Earned through raising many litters. Slightly speeds up bonding gains. Permanent.",
        "Troublemaker"  => "Prone to mischief around cage items. Permanent.",
        _               => trait
    };
}
