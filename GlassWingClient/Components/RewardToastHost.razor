@implements IDisposable
@inject RewardToastService Toasts

@if (Toasts.Active.Count > 0)
{
    <div class="position-fixed top-0 end-0 p-3" style="z-index:1080; max-width:360px">
        @foreach (var item in Toasts.Active)
        {
            <div class="alert alert-success alert-dismissible py-2 shadow-sm" role="alert">
                <button type="button" class="btn-close" aria-label="Dismiss"
                        @onclick="() => Toasts.Dismiss(item)"></button>
                <div class="fw-bold">@item.Headline</div>
                <div class="text-muted small">@item.Detail</div>
                @if (item.CurrencyAwarded is { } currency)
                {
                    <div class="text-success fw-bold small">+@currency.ToString("N0") cr</div>
                }
                @if (item.TitleDisplayText is not null)
                {
                    <div class="small">New title: @item.TitleDisplayText</div>
                }
                @if (item.CosmeticName is not null)
                {
                    <div class="small">New cosmetic: @item.CosmeticName</div>
                }
            </div>
        }
    </div>
}

@code {
    protected override void OnInitialized() => Toasts.OnChange += StateHasChanged;
    public void Dispose() => Toasts.OnChange -= StateHasChanged;
}
