@inherits LayoutComponentBase
@implements IDisposable
@inject AuthStateService Auth
@inject NavigationManager Nav
@inject GlassWingApiClient Api
@inject PlayerStateService PlayerState
@inject RewardToastService RewardToasts
@inject WelfareStateService Welfare

<RewardToastHost />

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex align-items-center justify-content-end gap-2">
            @if (PlayerState.Currency.HasValue)
            {
                <span class="badge bg-dark">@PlayerState.Currency.Value.ToString("N0") cr</span>
            }
            @if (Auth.IsDevBypass)
            {
                <span class="badge bg-warning text-dark">Dev Bypass</span>
            }
            else if (Auth.IsAuthenticated)
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick="Logout">Logout</button>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<WelfareLockOverlay />

@code {
    protected override async Task OnInitializedAsync()
    {
        PlayerState.OnChange += StateHasChanged;
        Welfare.OnChange += StateHasChanged;
        Nav.LocationChanged += OnLocationChanged;

        if (Auth.IsAuthenticated)
        {
            var profile = await Api.GetPlayerProfileAsync();
            if (profile is not null)
            {
                PlayerState.SetCurrency(profile.Currency);
                // Login/Register already persist these; this backfills the Dev Bypass path,
                // which never goes through either and would otherwise leave them null.
                Auth.PlayerId ??= profile.PlayerId;
                Auth.Username ??= profile.Username;
            }
            await Welfare.RefreshAsync();
        }
    }

    async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (Auth.IsAuthenticated) await Welfare.RefreshAsync();
    }

    void Logout()
    {
        Auth.Token = null;
        Auth.IsDevBypass = false;
        Auth.PlayerId = null;
        Auth.Username = null;
        PlayerState.SetCurrency(0);
        RewardToasts.ClearShownAchievements();
        RewardToasts.ClearShownChallenges();
        RewardToasts.ClearShownSeasonal();
        Nav.NavigateTo("/login");
    }

    public void Dispose()
    {
        PlayerState.OnChange -= StateHasChanged;
        Welfare.OnChange -= StateHasChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
