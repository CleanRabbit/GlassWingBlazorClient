@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/home">GlassWing</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="home" Match="NavLinkMatch.All">Home</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="rats">Rats</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="tricks">Tricks</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="events">Events</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="leaderboards">Leaderboards</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="shop">Shop</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="inventory">Inventory</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="marketplace">Marketplace</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="adoption">Adoption</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="progress">
                Progress
                @if (ProgressState.HasAnyPending)
                {
                    <span class="badge bg-danger rounded-pill ms-1">&nbsp;</span>
                }
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="profile">Profile</NavLink>
        </div>
        @if (Auth.IsAdmin)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin">Admin</NavLink>
            </div>
        }
    </nav>
</div>

@code {
    [Inject] AuthStateService Auth { get; set; } = default!;
    [Inject] ProgressStateService ProgressState { get; set; } = default!;

    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    protected override void OnInitialized() => ProgressState.OnChange += StateHasChanged;
    public void Dispose() => ProgressState.OnChange -= StateHasChanged;
}
