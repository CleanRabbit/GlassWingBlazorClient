@page "/shop/{Category}"
@inject GlassWingApiClient Api
@inject AuthStateService Auth
@inject NavigationManager Nav
@inject PlayerStateService PlayerState

<PageTitle>@CategoryTitle — GlassWing</PageTitle>

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/shop">Shop</a></li>
        <li class="breadcrumb-item active">@CategoryTitle</li>
    </ol>
</nav>

<h2 class="mb-4">@CategoryTitle</h2>

@if (!loaded)
{
    <p class="text-muted">Loading...</p>
}
else if (catalogue is null)
{
    <div class="alert alert-danger">Failed to load shop catalogue.</div>
}
else
{
    @if (success is not null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @success
            <button type="button" class="btn-close" @onclick="() => success = null"></button>
        </div>
    }
    @if (error is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @error
            <button type="button" class="btn-close" @onclick="() => error = null"></button>
        </div>
    }

    <div class="row g-3">

        @if (Category == "cages")
        {
            @foreach (var item in catalogue.Cages)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <h5 class="card-title mb-0">@item.Brand @item.ModelName</h5>
                                @if (item.Tier is not null)
                                {
                                    <span class="badge @TierBadge(item.Tier)">@item.Tier</span>
                                }
                            </div>
                            <p class="text-muted small mb-2">
                                @item.WidthCm × @item.DepthCm × @item.HeightCm cm ·
                                Up to @item.MaxCapacity rat@(item.MaxCapacity != 1 ? "s" : "") ·
                                @item.MaxFoodBowlSlots bowl slot@(item.MaxFoodBowlSlots != 1 ? "s" : "") ·
                                @item.MaxWaterBottleSlots bottle slot@(item.MaxWaterBottleSlots != 1 ? "s" : "")
                            </p>
                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <strong>@item.Price cr</strong>
                                <button class="btn btn-sm btn-primary"
                                        @onclick="() => BuyCageAsync(item.Id, item.Brand + ' ' + item.ModelName)"
                                        disabled="@busy">
                                    Buy
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else if (Category == "accessories")
        {
            @foreach (var item in catalogue.Accessories)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@item.Name</h5>
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <p class="text-muted small mb-2">@item.Description</p>
                            }
                            <p class="small mb-2">
                                <span class="text-muted">Enrichment</span> +@item.BaseEnrichment
                                @if (item.MinimumTier is not null)
                                {
                                    <span class="ms-2 text-muted">Requires</span>
                                    <span class="badge @TierBadge(item.MinimumTier) ms-1">@item.MinimumTier</span>
                                }
                            </p>
                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <strong>@item.Price cr</strong>
                                <button class="btn btn-sm btn-primary"
                                        @onclick="() => BuyAccessoryAsync(item.Id, item.Name)"
                                        disabled="@busy">
                                    Buy → Inventory
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else if (Category == "bowls")
        {
            @foreach (var item in catalogue.FoodBowls)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@item.Name</h5>
                            <p class="small mb-2">
                                <span class="text-muted">Capacity</span> @item.CapacityRatDays rat-day@(item.CapacityRatDays != 1 ? "s" : "")
                                @if (item.MinimumTier is not null)
                                {
                                    <span class="ms-2 text-muted">Requires</span>
                                    <span class="badge @TierBadge(item.MinimumTier) ms-1">@item.MinimumTier</span>
                                }
                            </p>
                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <strong>@item.Price cr</strong>
                                <button class="btn btn-sm btn-primary"
                                        @onclick="() => BuyBowlAsync(item.Id, item.Name)"
                                        disabled="@busy">
                                    Buy → Inventory
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else if (Category == "bottles")
        {
            @foreach (var item in catalogue.WaterBottles)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@item.Name</h5>
                            <p class="small mb-2">
                                <span class="text-muted">Capacity</span> @item.CapacityRatDays rat-day@(item.CapacityRatDays != 1 ? "s" : "")
                                @if (item.MinimumTier is not null)
                                {
                                    <span class="ms-2 text-muted">Requires</span>
                                    <span class="badge @TierBadge(item.MinimumTier) ms-1">@item.MinimumTier</span>
                                }
                            </p>
                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <strong>@item.Price cr</strong>
                                <button class="btn btn-sm btn-primary"
                                        @onclick="() => BuyBottleAsync(item.Id, item.Name)"
                                        disabled="@busy">
                                    Buy → Inventory
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else if (Category == "carry-cases")
        {
            @foreach (var item in catalogue.CarryCases ?? [])
            {
                var occupied = GetOccupiedSlots();
                var totalSlots = home?.TotalAccessorySlots ?? 0;
                var hasSpace = totalSlots > occupied.Count;
                <div class="col-md-6 col-xl-4">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@item.Name</h5>
                            <p class="small text-muted mb-2">Holds 1 rat for transport</p>
                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <strong>@item.Price cr</strong>
                                @if (anchorPanelItemId != item.Id)
                                {
                                    <button class="btn btn-sm btn-primary"
                                            @onclick="() => OpenAnchorPanel(item.Id, item.Name, item.Price)"
                                            disabled="@(busy || (home is not null && !hasSpace))"
                                            title="@(home is not null && !hasSpace ? "No free home slots" : null)">
                                        Buy
                                    </button>
                                }
                            </div>
                            @if (anchorPanelItemId == item.Id)
                            {
                                @AnchorPanel(occupied, totalSlots)
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else if (Category == "storage-drawers")
        {
            @foreach (var item in catalogue.StorageDrawers ?? [])
            {
                var occupied = GetOccupiedSlots();
                var totalSlots = home?.TotalAccessorySlots ?? 0;
                var hasSpace = totalSlots > occupied.Count;
                <div class="col-md-6 col-xl-4">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@item.Name</h5>
                            <p class="small mb-2">
                                <span class="text-muted">Slots</span> @item.SlotsPerUnit
                            </p>
                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <strong>@item.Price cr</strong>
                                @if (anchorPanelItemId != item.Id)
                                {
                                    <button class="btn btn-sm btn-primary"
                                            @onclick="() => OpenAnchorPanel(item.Id, item.Name, item.Price)"
                                            disabled="@(busy || (home is not null && !hasSpace))"
                                            title="@(home is not null && !hasSpace ? "No free home slots" : null)">
                                        Buy
                                    </button>
                                }
                            </div>
                            @if (anchorPanelItemId == item.Id)
                            {
                                @AnchorPanel(occupied, totalSlots)
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else if (Category == "food-bins")
        {
            @foreach (var item in catalogue.FoodStorageBins)
            {
                var occupied = GetOccupiedSlots();
                var totalSlots = home?.TotalAccessorySlots ?? 0;
                var hasSpace = totalSlots > occupied.Count;
                <div class="col-md-6 col-xl-4">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@item.Name</h5>
                            <p class="small mb-2">
                                <span class="text-muted">Capacity</span> @item.CapacityRatDays rat-days
                            </p>
                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <strong>@item.Price cr</strong>
                                @if (anchorPanelItemId != item.Id)
                                {
                                    <button class="btn btn-sm btn-primary"
                                            @onclick="() => OpenAnchorPanel(item.Id, item.Name, item.Price)"
                                            disabled="@(busy || (home is not null && !hasSpace))"
                                            title="@(home is not null && !hasSpace ? "No free home slots" : null)">
                                        Buy
                                    </button>
                                }
                            </div>
                            @if (anchorPanelItemId == item.Id)
                            {
                                @AnchorPanel(occupied, totalSlots)
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else if (Category == "food")
        {
            @foreach (var item in catalogue.Foods)
            {
                @FoodCard(item)
            }
        }
        else if (Category == "medications")
        {
            var devices      = (catalogue.Medications ?? []).Where(m => m.DeliveryType == "HomeAccessoryDevice").ToArray();
            var directDoses  = (catalogue.Medications ?? []).Where(m => m.DeliveryType == "DirectDose").ToArray();
            var medicatedFoods = catalogue.Foods.Where(f => f.TargetIllnessCategory is not null).ToArray();
            var occupied   = GetOccupiedSlots();
            var totalSlots = home?.TotalAccessorySlots ?? 0;
            var hasSpace   = totalSlots > occupied.Count;

            <h5 class="mb-3">Devices</h5>
            <div class="row g-3 mb-4">
                @foreach (var item in devices)
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="card h-100">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@item.Name</h5>
                                <p class="text-muted small mb-2">@item.Description</p>
                                <p class="small mb-2">
                                    <span class="text-muted">Targets</span> @item.TargetCategory ·
                                    <span class="text-muted">Cooldown</span> @item.UseCooldownHours h
                                </p>
                                <div class="d-flex justify-content-between align-items-center mt-auto">
                                    <strong>@item.InGamePrice cr</strong>
                                    @if (anchorPanelItemId != item.Id)
                                    {
                                        <button class="btn btn-sm btn-primary"
                                                @onclick='() => OpenAnchorPanel(item.Id, item.Name, item.InGamePrice, "medication-device")'
                                                disabled="@(busy || (home is not null && !hasSpace))"
                                                title="@(home is not null && !hasSpace ? "No free home slots" : null)">
                                            Buy
                                        </button>
                                    }
                                </div>
                                @if (anchorPanelItemId == item.Id)
                                {
                                    @AnchorPanel(occupied, totalSlots)
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <h5 class="mb-3">Direct Doses</h5>
            <div class="row g-3 mb-4">
                @foreach (var item in directDoses)
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="card h-100">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@item.Name</h5>
                                <p class="text-muted small mb-2">@item.Description</p>
                                <p class="small mb-2">
                                    <span class="text-muted">Targets</span> @item.TargetCategory
                                </p>
                                <div class="d-flex justify-content-between align-items-center mt-auto">
                                    <strong>@item.InGamePrice cr</strong>
                                    <button class="btn btn-sm btn-primary"
                                            @onclick="() => BuyMedicationDoseAsync(item.Id, item.Name)"
                                            disabled="@busy">
                                        Buy → Drawer
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <h5 class="mb-3">Medicated Food</h5>
            <div class="row g-3">
                @foreach (var item in medicatedFoods)
                {
                    @FoodCard(item)
                }
            </div>
        }

    </div>
}

@code {
    [Parameter] public string Category { get; set; } = "";

    ShopCatalogueResponse? catalogue;
    HomeResponse? home;
    bool loaded;
    bool busy;
    string? success;
    string? error;

    // Food buy panel
    string? foodBuyPanelId;
    string? selectedBinId;
    int foodRatDays = 1;

    // Anchor selection panel (carry cases, storage drawers, food bins)
    string? anchorPanelItemId;
    string? anchorPanelName;
    int anchorPanelPrice;
    string? anchorPanelCategory;
    int? selectedAnchorIndex;

    string CategoryTitle => Category switch
    {
        "cages"            => "Cages",
        "accessories"      => "Accessories",
        "bowls"            => "Food Bowls",
        "bottles"          => "Water Bottles",
        "carry-cases"      => "Carry Cases",
        "storage-drawers"  => "Storage Drawers",
        "food-bins"        => "Food Storage",
        "food"             => "Food",
        "medications"      => "Medications",
        _                  => "Shop"
    };

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login"); return; }
        var catalogueTask = Api.GetShopCatalogueAsync();
        Task<(HomeResponse?, string?)>? homeTask = null;
        if (Category is "carry-cases" or "storage-drawers" or "food-bins" or "food" or "medications")
            homeTask = Api.GetHomeAsync();
        catalogue = await catalogueTask;
        if (homeTask is not null)
            home = (await homeTask).Item1;
        loaded = true;
    }

    async Task BuyCageAsync(string typeId, string name)
    {
        busy = true; error = null; success = null;
        var (result, err) = await Api.BuyCageAsync(typeId);
        if (result is not null)
        {
            PlayerState.SetCurrency(result.NewBalance);
            success = $"Purchased {name}. New balance: {result.NewBalance:N0} cr";
        }
        else error = err;
        busy = false;
    }

    async Task BuyAccessoryAsync(string typeId, string name)
    {
        busy = true; error = null; success = null;
        var (result, err) = await Api.BuyAccessoryAsync(typeId);
        if (result is not null)
        {
            PlayerState.SetCurrency(result.NewBalance);
            success = $"{name} added to your inventory. New balance: {result.NewBalance:N0} cr";
        }
        else error = err;
        busy = false;
    }

    async Task BuyBowlAsync(string typeId, string name)
    {
        busy = true; error = null; success = null;
        var (result, err) = await Api.BuyBowlAsync(typeId);
        if (result is not null)
        {
            PlayerState.SetCurrency(result.NewBalance);
            success = $"{name} added to your inventory. New balance: {result.NewBalance:N0} cr";
        }
        else error = err;
        busy = false;
    }

    async Task BuyBottleAsync(string typeId, string name)
    {
        busy = true; error = null; success = null;
        var (result, err) = await Api.BuyBottleAsync(typeId);
        if (result is not null)
        {
            PlayerState.SetCurrency(result.NewBalance);
            success = $"{name} added to your inventory. New balance: {result.NewBalance:N0} cr";
        }
        else error = err;
        busy = false;
    }

    string AnchorCategory => Category switch
    {
        "carry-cases"     => "carry-case",
        "storage-drawers" => "storage-drawers",
        _                 => "food-bin"
    };

    void OpenAnchorPanel(string itemId, string name, int price, string? categoryOverride = null)
    {
        anchorPanelItemId = itemId;
        anchorPanelName = name;
        anchorPanelPrice = price;
        anchorPanelCategory = categoryOverride ?? AnchorCategory;
        selectedAnchorIndex = null;
        error = null;
        success = null;
    }

    void CloseAnchorPanel()
    {
        anchorPanelItemId = null;
        selectedAnchorIndex = null;
    }

    HashSet<int> GetOccupiedSlots()
    {
        var set = new HashSet<int>();
        if (home is null) return set;
        foreach (var cc in home.CarryCases ?? []) set.Add(cc.AnchorIndex);
        foreach (var sd in home.StorageDrawers ?? []) set.Add(sd.AnchorIndex);
        foreach (var fb in home.FoodStorageBins ?? []) set.Add(fb.AnchorIndex);
        foreach (var md in home.MedicationDevices ?? []) set.Add(md.AnchorIndex);
        return set;
    }

    async Task ConfirmHomeAccessoryBuyAsync()
    {
        if (selectedAnchorIndex is null) return;
        busy = true; error = null; success = null;
        var anchorIndex = selectedAnchorIndex.Value;
        decimal newBalance;

        if (anchorPanelCategory == "carry-case")
        {
            var (result, err) = await Api.BuyCarryCaseAsync(anchorIndex);
            if (result is null) { error = err; busy = false; return; }
            newBalance = result.NewBalance;
        }
        else if (anchorPanelCategory == "storage-drawers")
        {
            var (result, err) = await Api.BuyStorageDrawersAsync(anchorIndex);
            if (result is null) { error = err; busy = false; return; }
            newBalance = result.NewBalance;
        }
        else if (anchorPanelCategory == "medication-device")
        {
            var (result, err) = await Api.BuyMedicationDeviceAsync(anchorPanelItemId!, anchorIndex);
            if (result is null) { error = err; busy = false; return; }
            newBalance = result.NewBalance;
        }
        else
        {
            var (result, err) = await Api.BuyFoodStorageBinAsync(anchorIndex);
            if (result is null) { error = err; busy = false; return; }
            newBalance = result.NewBalance;
        }

        PlayerState.SetCurrency(newBalance);
        success = $"{anchorPanelName} placed in Slot {anchorIndex + 1}. New balance: {newBalance:N0} cr";
        CloseAnchorPanel();
        var (homeData, _) = await Api.GetHomeAsync();
        if (homeData is not null) home = homeData;
        busy = false;
    }

    async Task BuyMedicationDoseAsync(string typeId, string name)
    {
        busy = true; error = null; success = null;
        var (result, err) = await Api.BuyMedicationDoseAsync(typeId);
        if (result is not null)
        {
            PlayerState.SetCurrency(result.NewBalance);
            success = $"{name} added to your storage drawers. New balance: {result.NewBalance:N0} cr";
        }
        else error = err;
        busy = false;
    }

    RenderFragment FoodCard(ShopFoodType item) => __builder =>
    {
        <div class="col-md-6 col-xl-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <h5 class="card-title mb-0">@item.Name</h5>
                        @if (item.TargetIllnessCategory is not null)
                        {
                            <span class="badge bg-info text-dark">Medicinal — @item.TargetIllnessCategory</span>
                        }
                    </div>
                    <p class="small mb-1">
                        <span class="text-muted">Quality tier</span> @item.QualityTier
                    </p>
                    @if (item.HealthBonus is { } hb && hb > 0)
                    {
                        <p class="small mb-1">
                            <span class="text-muted">Health bonus</span>
                            <span class="text-success">+@(hb.ToString("P0"))</span>
                        </p>
                    }
                    <p class="small mb-2">
                        <strong>@item.InGamePrice cr</strong>
                        <span class="text-muted">/ rat-day</span>
                    </p>

                    @if (foodBuyPanelId == item.Id)
                    {
                        <div class="border rounded p-2 mb-2 bg-light">
                            @if (home is null)
                            {
                                <p class="text-muted small mb-0">Loading storage bins...</p>
                            }
                            else
                            {
                                var bins = home.FoodStorageBins ?? [];
                                @if (bins.Length == 0)
                                {
                                    <p class="text-muted small mb-1">No food storage bins. Buy one from <a href="/shop/food-bins">Food Storage</a>.</p>
                                    <button class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => foodBuyPanelId = null">
                                        Cancel
                                    </button>
                                }
                                else
                                {
                                    <div class="mb-2">
                                        <label class="form-label small">Storage bin</label>
                                        <select class="form-select form-select-sm" @bind="selectedBinId">
                                            <option value="">— select —</option>
                                            @foreach (var bin in bins)
                                            {
                                                <option value="@bin.Id">
                                                    Food Storage Bin (@bin.StoredRatDays.ToString("F0") / @bin.CapacityRatDays rd used)
                                                </option>
                                            }
                                        </select>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label small">Rat-days to buy</label>
                                        <input class="form-control form-control-sm" type="number" min="1"
                                               @bind="foodRatDays" />
                                        @if (foodRatDays > 0)
                                        {
                                            <div class="text-muted small mt-1">
                                                Total: @(foodRatDays * item.InGamePrice) cr
                                            </div>
                                        }
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-sm btn-primary"
                                                @onclick="() => ConfirmBuyFoodAsync(item.Id)"
                                                disabled="@(busy || string.IsNullOrEmpty(selectedBinId) || foodRatDays < 1)">
                                            Confirm
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary"
                                                @onclick="() => foodBuyPanelId = null">
                                            Cancel
                                        </button>
                                    </div>
                                }
                            }
                        </div>
                    }
                    else
                    {
                        <div class="mt-auto">
                            <button class="btn btn-sm btn-primary"
                                    @onclick="() => OpenFoodBuyPanelAsync(item.Id)"
                                    disabled="@busy">
                                Buy
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    };

    async Task OpenFoodBuyPanelAsync(string foodTypeId)
    {
        foodBuyPanelId = foodTypeId;
        selectedBinId = null;
        foodRatDays = 1;
        if (home is null)
        {
            var (data, _) = await Api.GetHomeAsync();
            home = data;
        }
    }

    async Task ConfirmBuyFoodAsync(string foodTypeId)
    {
        if (string.IsNullOrEmpty(selectedBinId) || foodRatDays < 1) return;
        busy = true; error = null; success = null;
        var (result, err) = await Api.BuyFoodAsync(selectedBinId, foodTypeId, foodRatDays);
        if (result is not null)
        {
            PlayerState.SetCurrency(result.NewBalance);
            success = $"Stored {result.StoredRatDays} rat-days of food. New balance: {result.NewBalance:N0} cr";
            foodBuyPanelId = null;
        }
        else error = err;
        busy = false;
    }

    RenderFragment AnchorPanel(HashSet<int> occupied, int totalSlots) => __builder =>
    {
        <div class="border rounded p-2 mt-2 bg-light">
            @if (selectedAnchorIndex is null)
            {
                <p class="small fw-semibold mb-2">Select a home slot</p>
                <div class="d-flex flex-wrap gap-1 mb-2">
                    @for (int si = 0; si < totalSlots; si++)
                    {
                        var slotIdx = si;
                        var isOccupied = occupied.Contains(slotIdx);
                        <button class="btn btn-sm @(isOccupied ? "btn-outline-secondary" : "btn-outline-primary")"
                                disabled="@(isOccupied || busy)"
                                @onclick="() => selectedAnchorIndex = slotIdx">
                            @(slotIdx + 1)
                        </button>
                    }
                </div>
                <button class="btn btn-sm btn-link text-muted p-0" @onclick="CloseAnchorPanel">Cancel</button>
            }
            else
            {
                <p class="small fw-semibold mb-1">Confirm purchase</p>
                <p class="small text-muted mb-2">@anchorPanelName · Slot @(selectedAnchorIndex + 1) · @anchorPanelPrice cr</p>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-primary" disabled="@busy" @onclick="ConfirmHomeAccessoryBuyAsync">
                        @(busy ? "..." : "Confirm")
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => selectedAnchorIndex = null">Back</button>
                </div>
            }
        </div>
    };

    static string TierBadge(string? tier) => tier switch
    {
        "Starter" => "bg-secondary",
        "Budget"  => "bg-info text-dark",
        "Mid"     => "bg-info text-dark",
        "Large"   => "bg-primary",
        "Premium" => "bg-warning text-dark",
        "Bespoke" => "bg-danger",
        _         => "bg-secondary"
    };
}
