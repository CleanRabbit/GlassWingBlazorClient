@page "/events"
@implements IDisposable
@inject GlassWingApiClient Api
@inject AuthStateService Auth
@inject PlayerStateService PlayerState
@inject NavigationManager Nav
@inject WelfareStateService Welfare

<PageTitle>Events — GlassWing</PageTitle>
<h1 class="mb-4">Events</h1>

@if (Welfare.IsEventsLocked)
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center">
        <span>Adopt a companion rat to continue entering events.</span>
        <a href="/adoption" class="btn btn-sm btn-primary">Adopt a companion</a>
    </div>
}

<!-- Getting Started -->
<div class="card mb-4 border-secondary">
    <div class="card-header d-flex align-items-center gap-2">
        <span class="fw-semibold">Getting Started</span>
        <span class="badge bg-secondary">Tutorial</span>
    </div>
    <div class="card-body">
        <p class="card-text text-muted small mb-3">
            Run a quick tutorial sprint race to get familiar with the event system.
            In the final game this is a one-time event.
        </p>

        @if (tutorialResult is not null)
        {
            var entry = tutorialResult.Event?.Entries.FirstOrDefault(e => e.IsPlayer);
            <div class="alert alert-success py-2 mb-3">
                Finished @Ordinal(entry?.Placement) with score <strong>@entry?.Score</strong>.
                Awarded <strong>@tutorialResult.Event?.CurrencyAwarded cr</strong>.
                New balance: <strong>@tutorialResult.NewCurrencyBalance.ToString("N0") cr</strong>.
            </div>
        }
        @if (tutorialError is not null)
        {
            <div class="alert alert-danger py-2 mb-3">@tutorialError</div>
        }

        @if (!tutorialExpanded)
        {
            <button class="btn btn-outline-secondary btn-sm" @onclick="() => { tutorialExpanded = true; tutorialResult = null; tutorialError = null; }">
                Run Tutorial
            </button>
        }
        else
        {
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <select class="form-select form-select-sm" style="max-width: 220px" @bind="tutorialRatId">
                    <option value="">— pick a rat —</option>
                    @foreach (var r in rats?.Where(IsEventEligible) ?? [])
                    {
                        <option value="@r.Id">@r.Name</option>
                    }
                </select>
                <button class="btn btn-primary btn-sm"
                        disabled="@(string.IsNullOrEmpty(tutorialRatId) || tutorialBusy)"
                        @onclick="RunTutorialAsync">
                    @(tutorialBusy ? "Running..." : "Run")
                </button>
                <button class="btn btn-link btn-sm text-muted p-0"
                        @onclick="() => { tutorialExpanded = false; tutorialRatId = string.Empty; }">
                    Cancel
                </button>
            </div>
        }
    </div>
</div>

<!-- Two-panel layout -->
<div class="row g-4 mb-4">

    <!-- Live Lobbies -->
    <div class="col-lg-7">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0">Live Lobbies</h4>
            <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshAsync" disabled="@lobbiesLoading">
                @(lobbiesLoading ? "Refreshing..." : "Refresh")
            </button>
        </div>

        @if (lobbiesLoading)
        {
            <p class="text-muted small">Loading lobbies...</p>
        }
        else if (lobbies is null)
        {
            <p class="text-muted small">Failed to load lobbies.</p>
        }
        else if (lobbies.Length == 0)
        {
            <p class="text-muted small">No open lobbies right now. Check back soon or create your own.</p>
        }
        else
        {
            @foreach (var lobby in lobbies)
            {
                var fee = lobby.EntryFee;
                var isActive = activeLobbyId == lobby.Id;
                <div class="card mb-2">
                    <div class="card-body py-2 px-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="fw-semibold me-2">@lobby.EventName</span>
                                <span class="badge @TypeBadgeClass(lobby.EventType) me-1">@TypeLabel(lobby.EventType)</span>
                                @if (fee > 0)
                                {
                                    <span class="badge bg-light text-dark border">@fee cr</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-success border">Free</span>
                                }
                            </div>
                            <button class="btn btn-outline-primary btn-sm ms-2"
                                    @onclick="() => ToggleLobbyEntry(lobby.Id)"
                                    disabled="@((entryBusy && isActive) || (Welfare.IsEventsLocked && !isActive))">
                                @(isActive ? "Cancel" : "Enter")
                            </button>
                        </div>
                        <div class="text-muted small mt-1">
                            Runs at @lobby.ScheduledRunAt.ToLocalTime().ToString("HH:mm") &middot; @lobby.EntrantsCount/@lobby.PlayerSlots slots
                        </div>

                        @if (isActive)
                        {
                            <div class="mt-2 pt-2 border-top d-flex align-items-center gap-2 flex-wrap">
                                <select class="form-select form-select-sm" style="max-width: 220px" @bind="activeRatId" @bind:after="OnActiveRatChanged">
                                    <option value="">— pick a rat —</option>
                                    @foreach (var r in rats?.Where(IsEventEligible) ?? [])
                                    {
                                        <option value="@r.Id">@r.Name</option>
                                    }
                                </select>
                                @if (fee > 0)
                                {
                                    <span class="text-muted small">Entry: @fee cr</span>
                                }
                                <button class="btn btn-primary btn-sm"
                                        disabled="@(string.IsNullOrEmpty(activeRatId) || entryBusy || RoutineInvalid(lobby.EventType) || Welfare.IsEventsLocked)"
                                        @onclick="() => EnterLobbyAsync(lobby)">
                                    @(entryBusy ? "Entering..." : "Confirm")
                                </button>
                                @if (Welfare.IsEventsLocked)
                                {
                                    <span class="text-muted small">Blocked — adopt a companion first</span>
                                }
                            </div>
                            @if (lobby.EventType == "TricksPerformance" && !string.IsNullOrEmpty(activeRatId))
                            {
                                @RoutineBuilder()
                            }
                            @if (entryError is not null)
                            {
                                <div class="alert alert-danger py-1 px-2 small mt-2 mb-0">@entryError</div>
                            }
                        }
                    </div>
                </div>
            }
        }
    </div>

    <!-- Create Event -->
    <div class="col-lg-5">
        <h4 class="mb-3">Create Event</h4>
        @foreach (var def in PlayerInitiatedDefs)
        {
            var isActive = activeCreateId == def.Id;
            <div class="card mb-2">
                <div class="card-body py-2 px-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="fw-semibold me-2">@def.Name</span>
                            <span class="badge @TypeBadgeClass(def.EventType)">@TypeLabel(def.EventType)</span>
                        </div>
                        <button class="btn btn-outline-success btn-sm ms-2"
                                @onclick="() => ToggleCreate(def.Id)"
                                disabled="@((createBusy && isActive) || (Welfare.IsEventsLocked && !isActive))">
                            @(isActive ? "Cancel" : "Create")
                        </button>
                    </div>
                    <div class="text-muted small mt-1">Free entry &middot; 30 min lobby &middot; 300 / 100 / 25 cr</div>

                    @if (isActive)
                    {
                        <div class="mt-2 pt-2 border-top d-flex align-items-center gap-2 flex-wrap">
                            <select class="form-select form-select-sm" style="max-width: 220px" @bind="activeRatId" @bind:after="OnActiveRatChanged">
                                <option value="">— pick a rat —</option>
                                @foreach (var r in rats?.Where(IsEventEligible) ?? [])
                                {
                                    <option value="@r.Id">@r.Name</option>
                                }
                            </select>
                            <button class="btn btn-success btn-sm"
                                    disabled="@(string.IsNullOrEmpty(activeRatId) || createBusy || RoutineInvalid(def.EventType) || Welfare.IsEventsLocked)"
                                    @onclick="() => CreateLobbyAsync(def.Id)">
                                @(createBusy ? "Creating..." : "Create & Enter")
                            </button>
                            @if (Welfare.IsEventsLocked)
                            {
                                <span class="text-muted small">Blocked — adopt a companion first</span>
                            }
                        </div>
                        @if (def.EventType == "TricksPerformance" && !string.IsNullOrEmpty(activeRatId))
                        {
                            @RoutineBuilder()
                        }
                        @if (createError is not null)
                        {
                            <div class="alert alert-danger py-1 px-2 small mt-2 mb-0">@createError</div>
                        }
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Recently Entered -->
@if (myEvents is not null && (myEvents.ActiveEntries.Length > 0 || myEvents.RecentResults.Length > 0))
{
    <h4 class="mb-3">Recently Entered</h4>
    <div class="list-group">
        @foreach (var entry in myEvents.ActiveEntries)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <span class="fw-semibold me-2">@entry.EventName</span>
                    <span class="badge @TypeBadgeClass(entry.EventType) me-2">@TypeLabel(entry.EventType)</span>
                    <span class="badge bg-success">Open</span>
                </div>
                <span class="text-muted small">Runs at @entry.ScheduledRunAt.ToLocalTime().ToString("HH:mm") &middot; @entry.EntrantsCount/@entry.PlayerSlots slots</span>
            </div>
        }
        @foreach (var result in myEvents.RecentResults)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <span class="fw-semibold me-2">@result.EventName</span>
                    <span class="badge @TypeBadgeClass(result.EventType) me-2">@TypeLabel(result.EventType)</span>
                    <span class="badge bg-secondary me-2">Completed</span>
                    <span class="text-muted small">@Ordinal(result.Placement) &middot; score @result.Score@(result.CurrencyAwarded > 0 ? $" · {result.CurrencyAwarded} cr" : "")</span>
                </div>
                <a href="/events/@result.LobbyId/results" class="btn btn-sm btn-outline-primary">View Results</a>
            </div>
        }
    </div>
}

@code {
    record PlayerInitiatedDef(string Id, string Name, string EventType);

    static readonly PlayerInitiatedDef[] PlayerInitiatedDefs =
    [
        new("open-sprint",    "Open Sprint",    "Sprint"),
        new("open-agility",   "Open Agility",   "AgilityCourse"),
        new("open-endurance", "Open Endurance", "Endurance"),
        new("open-tricks",    "Open Tricks",    "TricksPerformance"),
    ];

    RatResponse[]? rats;
    LobbyResponse[]? lobbies;
    bool lobbiesLoading = true;
    PlayerEventsResponse? myEvents;
    GameSettingsResponse? settings;
    TrickCatalogueResponse? trickCatalogue;
    readonly HashSet<string> selectedRoutine = [];

    // Tutorial state
    bool tutorialExpanded;
    string tutorialRatId = string.Empty;
    bool tutorialBusy;
    TutorialEventResponse? tutorialResult;
    string? tutorialError;

    // Lobby / create state
    string? activeLobbyId;
    string? activeCreateId;
    string activeRatId = string.Empty;
    bool entryBusy;
    bool createBusy;
    string? entryError;
    string? createError;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login"); return; }
        Welfare.OnChange += StateHasChanged;
        await Task.WhenAll(LoadRatsAsync(), RefreshLobbiesAsync(), RefreshMyEventsAsync(), LoadSettingsAsync(), LoadTrickCatalogueAsync());
    }

    public void Dispose() => Welfare.OnChange -= StateHasChanged;

    async Task LoadRatsAsync() =>
        rats = await Api.ListRatsAsync() ?? [];

    async Task LoadSettingsAsync() => settings = await Api.GetGameSettingsAsync();

    async Task LoadTrickCatalogueAsync() => trickCatalogue = await Api.GetTrickCatalogueAsync();

    static bool IsEventEligible(RatResponse r) =>
        !r.IsRetired && !r.IsNursing && r.LifeStage is not ("Weening" or "Infant");

    async Task RefreshAsync()
    {
        await Task.WhenAll(RefreshLobbiesAsync(), RefreshMyEventsAsync());
    }

    async Task RefreshLobbiesAsync()
    {
        lobbiesLoading = true;
        lobbies = await Api.GetOpenLobbiesAsync();
        lobbiesLoading = false;
    }

    async Task RefreshMyEventsAsync() =>
        myEvents = await Api.GetMyEventsAsync();

    void ToggleLobbyEntry(string lobbyId)
    {
        if (activeLobbyId == lobbyId)
        {
            activeLobbyId = null;
        }
        else
        {
            activeLobbyId = lobbyId;
            activeCreateId = null;
            activeRatId = string.Empty;
            entryError = null;
            selectedRoutine.Clear();
        }
    }

    void ToggleCreate(string definitionId)
    {
        if (activeCreateId == definitionId)
        {
            activeCreateId = null;
        }
        else
        {
            activeCreateId = definitionId;
            activeLobbyId = null;
            activeRatId = string.Empty;
            createError = null;
            selectedRoutine.Clear();
        }
    }

    void OnActiveRatChanged() => selectedRoutine.Clear();

    List<TrickDefinition> GetLearnedTricks(string ratId) =>
        trickCatalogue?.Categories.SelectMany(c => c.Tricks)
            .Where(t => t.Rats.Any(r => r.RatId == ratId && r.Status == "Learned"))
            .ToList() ?? [];

    bool RoutineInvalid(string eventType) =>
        eventType == "TricksPerformance" && !string.IsNullOrEmpty(activeRatId) && selectedRoutine.Count == 0;

    void ToggleRoutineTrick(string trickId, bool isChecked)
    {
        if (isChecked) selectedRoutine.Add(trickId);
        else selectedRoutine.Remove(trickId);
    }

    RenderFragment RoutineBuilder() => __builder =>
    {
        var learnedTricks = GetLearnedTricks(activeRatId);
        var maxSize = settings?.TrickMaxRoutineSize ?? 5;
        <div class="mt-2 pt-2 border-top">
            <div class="text-muted small mb-1">Routine — @selectedRoutine.Count / @maxSize selected</div>
            @if (learnedTricks.Count == 0)
            {
                <p class="text-muted small mb-0">This rat hasn't learned any tricks yet.</p>
            }
            else
            {
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var trick in learnedTricks)
                    {
                        var isChecked = selectedRoutine.Contains(trick.Id);
                        var atCap = !isChecked && selectedRoutine.Count >= maxSize;
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="@("routine-" + trick.Id)"
                                   checked="@isChecked" disabled="@atCap"
                                   @onchange="e => ToggleRoutineTrick(trick.Id, e.Value is bool b && b)" />
                            <label class="form-check-label small" for="@("routine-" + trick.Id)">@trick.Name</label>
                        </div>
                    }
                </div>
            }
        </div>
    };

    async Task RunTutorialAsync()
    {
        tutorialBusy = true;
        tutorialResult = null;
        tutorialError = null;
        var (result, error) = await Api.RunTutorialAsync(tutorialRatId);
        tutorialResult = result;
        if (tutorialResult is null)
            tutorialError = error ?? "Tutorial failed — check that the rat is eligible.";
        else
        {
            PlayerState.SetCurrency(tutorialResult.NewCurrencyBalance);
            tutorialExpanded = false;
            tutorialRatId = string.Empty;
            await Welfare.RefreshAsync(); // tutorial completion is what triggers the PostTutorialAdoption block
        }
        tutorialBusy = false;
    }

    async Task EnterLobbyAsync(LobbyResponse lobby)
    {
        entryBusy = true;
        entryError = null;
        var routine = lobby.EventType == "TricksPerformance" ? selectedRoutine.ToArray() : null;
        var (success, error) = await Api.EnterLobbyAsync(lobby.Id, activeRatId, routine);
        if (success)
        {
            activeLobbyId = null;
            activeRatId = string.Empty;
            selectedRoutine.Clear();
            if (lobby.EntryFee > 0)
            {
                var profile = await Api.GetPlayerProfileAsync();
                if (profile is not null) PlayerState.SetCurrency(profile.Currency);
            }
            await Task.WhenAll(RefreshLobbiesAsync(), RefreshMyEventsAsync());
        }
        else
        {
            // A 409 welfare-block response is resynced globally by WelfareBlockDetectionHandler
            // + WelfareBlockSignal — no need to refresh explicitly here.
            entryError = error ?? "Failed to enter lobby.";
        }
        entryBusy = false;
    }

    async Task CreateLobbyAsync(string definitionId)
    {
        createBusy = true;
        createError = null;
        var def = PlayerInitiatedDefs.FirstOrDefault(d => d.Id == definitionId);
        var routine = def?.EventType == "TricksPerformance" ? selectedRoutine.ToArray() : null;
        var (lobby, error) = await Api.CreateLobbyAsync(definitionId, activeRatId, routine);
        if (lobby is not null)
        {
            activeCreateId = null;
            activeRatId = string.Empty;
            selectedRoutine.Clear();
            await Task.WhenAll(RefreshLobbiesAsync(), RefreshMyEventsAsync());
        }
        else
        {
            // A 409 welfare-block response is resynced globally by WelfareBlockDetectionHandler
            // + WelfareBlockSignal — no need to refresh explicitly here.
            createError = error ?? "Failed to create lobby.";
        }
        createBusy = false;
    }

    static string TypeBadgeClass(string eventType) => eventType switch
    {
        "Sprint"            => "bg-warning text-dark",
        "AgilityCourse"     => "bg-success",
        "Endurance"         => "bg-info text-dark",
        "TricksPerformance" => "bg-dark",
        _                   => "bg-secondary"
    };

    static string TypeLabel(string eventType) => eventType switch
    {
        "AgilityCourse"     => "Agility",
        "TricksPerformance" => "Tricks",
        _                   => eventType
    };

    static string StatusBadgeClass(string status) => status switch
    {
        "Open"      => "bg-success",
        "Running"   => "bg-warning text-dark",
        "Completed" => "bg-secondary",
        "Cancelled" => "bg-danger",
        _           => "bg-secondary"
    };

    static string? Ordinal(int? placement) => placement switch
    {
        1   => "1st",
        2   => "2nd",
        3   => "3rd",
        int n => $"{n}th",
        null => null
    };
}
