        ["IllnessProgressionScale"] = "Mechanic Scales",
        ["StressDecayMultiplier"] = "Mechanic Scales",

        ["AgeDeclineOnsetMonths"] = "Age & Decline",
        ["AgeStressMultiplierMax"] = "Age & Decline",
        ["AgeIllnessMultiplierMax"] = "Age & Decline",

        ["MaxEventsPerWindow"] = "Events",
        ["EventCooldownWindowHours"] = "Events",

        ["ListingFeeAmount"] = "Marketplace",
        ["TransactionFeePercent"] = "Marketplace",

        ["RatLifespanYears"] = "Retirement",
        ["CriticalHealthRetirementDays"] = "Retirement",
        ["RetirementWarningEarlyPlayerDays"] = "Retirement",
        ["RetirementWarningLatePlayerDays"] = "Retirement",

        ["MinBreedingAgeRatWeeks"] = "Breeding",
        ["MaxBreedingAgeRatWeeks"] = "Breeding",
        ["MaleMaxSiringAgeRatMonths"] = "Breeding",
        ["MaxLittersPerFemale"] = "Breeding",
        ["MinGestationRatDays"] = "Breeding",
        ["MaxGestationRatDays"] = "Breeding",
        ["MinLitterSize"] = "Breeding",
        ["MaxLitterSize"] = "Breeding",
        ["GestationFoodMultiplier"] = "Breeding",
        ["PupsIndependenceRatWeeks"] = "Breeding",
        ["ProtectiveMotherProbability"] = "Breeding",

        ["WeeningScaleRatWeeks"] = "Life Stages",
        ["InfantScaleRatWeeks"] = "Life Stages",
        ["JuvenileScaleRatWeeks"] = "Life Stages",

        ["PotentialNutritionModifier"] = "Potential Modifiers",
        ["PotentialStressModifier"] = "Potential Modifiers",
        ["PotentialCageStressModifier"] = "Potential Modifiers",
        ["PotentialHealthModifier"] = "Potential Modifiers",

        ["FreeRoamAbilityGain"] = "Training",

