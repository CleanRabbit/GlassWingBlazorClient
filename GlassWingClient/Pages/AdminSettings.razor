@page "/admin/settings"
@inject GlassWingApiClient Api
@inject AuthStateService Auth
@inject NavigationManager Nav

<PageTitle>Settings — Admin — GlassWing</PageTitle>

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
        <li class="breadcrumb-item active">Settings</li>
    </ol>
</nav>

<h1 class="mb-1">GameBalance Settings</h1>
<p class="text-muted">
    Changes apply live to every player immediately — no redeploy, no restart. Values are entered
    as raw JSON matching the field's type (e.g. <code>24.5</code> for a number,
    <code>"2026-02-01T00:00:00Z"</code> for a date).
</p>

@if (!loaded)
{
    <p>Loading...</p>
}
else if (loadError is not null)
{
    <div class="alert alert-danger">@loadError</div>
}
else
{
    @foreach (var group in Grouped())
    {
        <h6 class="text-muted mt-4 mb-2">@group.Category</h6>
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Field</th>
                    <th>Default</th>
                    <th>Current</th>
                    <th></th>
                    <th style="width:260px">Edit</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var field in group.Fields)
                {
                    <tr class="@(field.IsAnchorField ? "table-warning" : "")">
                        <td>
                            @field.Name
                            @if (field.IsAnchorField)
                            {
                                <div class="small text-danger">
                                    Anchor date — changing this immediately recomputes which
                                    season/week is "current" for every player.
                                </div>
                            }
                        </td>
                        <td class="text-muted">@Render(field.DefaultValue)</td>
                        <td>@Render(field.CurrentValue)</td>
                        <td>
                            @if (field.IsOverridden)
                            {
                                <span class="badge bg-info text-dark">overridden</span>
                            }
                        </td>
                        <td>
                            <input class="form-control form-control-sm" placeholder="new raw JSON value"
                                   @bind="editValues[field.Name]" />
                        </td>
                        <td class="text-nowrap">
                            <button class="btn btn-sm btn-primary me-1" @onclick="() => SetAsync(field.Name)" disabled="@(busyField == field.Name)">
                                Save
                            </button>
                            @if (field.IsOverridden)
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => ResetAsync(field.Name)" disabled="@(busyField == field.Name)">
                                    Reset
                                </button>
                            }
                        </td>
                    </tr>
                    @if (fieldErrors.TryGetValue(field.Name, out var err))
                    {
                        <tr>
                            <td colspan="6" class="text-danger small">@err</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
}

@code {
    bool loaded;
    string? loadError;
    AdminGameSettingFieldDto[] fields = [];
    readonly Dictionary<string, string> editValues = new();
    readonly Dictionary<string, string> fieldErrors = new();
    string? busyField;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAdmin) { Nav.NavigateTo("/home"); return; }
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        loaded = false;
        var result = await Api.AdminGetSettingsAsync();
        loaded = true;

        if (result is null)
        {
            loadError = "Failed to load settings.";
            return;
        }

        fields = result;
    }

    async Task SetAsync(string fieldName)
    {
        if (!editValues.TryGetValue(fieldName, out var rawValue) || string.IsNullOrWhiteSpace(rawValue))
        {
            fieldErrors[fieldName] = "Enter a value first.";
            return;
        }

        busyField = fieldName;
        fieldErrors.Remove(fieldName);
        var (success, error) = await Api.AdminSetSettingAsync(fieldName, rawValue);
        busyField = null;

        if (!success)
        {
            fieldErrors[fieldName] = error ?? "Failed to apply.";
            return;
        }

        editValues.Remove(fieldName);
        await LoadAsync();
    }

    async Task ResetAsync(string fieldName)
    {
        busyField = fieldName;
        fieldErrors.Remove(fieldName);
        var (success, error) = await Api.AdminRemoveSettingOverrideAsync(fieldName);
        busyField = null;

        if (!success)
        {
            fieldErrors[fieldName] = error ?? "Failed to reset.";
            return;
        }

        await LoadAsync();
    }

    static string Render(System.Text.Json.JsonElement value) => value.ValueKind switch
    {
        System.Text.Json.JsonValueKind.String => value.GetString() ?? "",
        System.Text.Json.JsonValueKind.True or System.Text.Json.JsonValueKind.False => value.GetRawText(),
        System.Text.Json.JsonValueKind.Number => value.GetRawText(),
        _ => value.GetRawText()
    };

    record FieldGroup(string Category, AdminGameSettingFieldDto[] Fields);

    // Task 32 §4 — grouped the same way GameSettings.cs's own doc comments already group these
    // fields (biological/training/breeding/weather/personality/etc.), since the server doesn't
    // return a category — it's presentation-only, not a domain concept worth a new API field for.
    // Unmapped fields fall into "Other" rather than being dropped, mirroring the server's own
    // "log and skip, never throw" tolerance for fields it doesn't recognize (Task32_Design.md §5).
