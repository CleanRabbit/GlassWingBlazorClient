    IEnumerable<FieldGroup> Grouped() =>
        fields
            .GroupBy(f => Category.GetValueOrDefault(f.Name, "Other"))
            .OrderBy(g => g.Key == "Other" ? 1 : 0)
            .ThenBy(g => g.Key, StringComparer.Ordinal)
            .Select(g => new FieldGroup(g.Key, g.OrderBy(f => f.Name, StringComparer.Ordinal).ToArray()));
}
