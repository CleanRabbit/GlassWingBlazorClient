@page "/"
@page "/home"
@inject GlassWingApiClient Api
@inject AuthStateService Auth
@inject NavigationManager Nav

<PageTitle>Home — GlassWing</PageTitle>

@if (home is null)
{
    <p>Loading...</p>
}
else
{
    <div class="d-flex align-items-center gap-3 mb-4">
        @if (!renaming)
        {
            <h1 class="mb-0">@home.Name</h1>
            <button class="btn btn-sm btn-outline-secondary" @onclick="StartRename">Rename</button>
        }
        else
        {
            <input class="form-control w-auto" @bind="renameValue" />
            <button class="btn btn-sm btn-primary" @onclick="ConfirmRenameAsync">Save</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => renaming = false">Cancel</button>
        }
    </div>

    @foreach (var cage in home.Cages)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@cage.Name</h5>
                <div class="row mb-2">
                    <div class="col-sm-3 text-muted small">Food</div>
                    <div class="col-sm-9">@cage.FoodLevel @(cage.Food is not null ? $"({cage.Food})" : "")</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-3 text-muted small">Water</div>
                    <div class="col-sm-9">@cage.WaterLevel</div>
                </div>
                @if (cage.Regime is not null)
                {
                    <div class="row mb-2">
                        <div class="col-sm-3 text-muted small">Regime</div>
                        <div class="col-sm-9">@cage.Regime</div>
                    </div>
                }
                <div class="d-flex gap-2 mb-2">
                    <button class="btn btn-sm btn-outline-success"
                            @onclick="() => RefillFoodAsync(cage.Id)"
                            disabled="@IsBusy(cage.Id)">
                        Refill Food
                    </button>
                    <button class="btn btn-sm btn-outline-info"
                            @onclick="() => RefillWaterAsync(cage.Id)"
                            disabled="@IsBusy(cage.Id)">
                        Refill Water
                    </button>
                </div>
                @if (cage.Rats.Length > 0)
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var rat in cage.Rats)
                        {
                            <li><a href="/rats/@rat.Id">@rat.Name</a></li>
                        }
                    </ul>
                }
                else
                {
                    <small class="text-muted">Empty cage</small>
                }
            </div>
        </div>
    }
}

@code {
    HomeResponse? home;
    bool renaming;
    string renameValue = "";
    readonly HashSet<string> busyCages = [];

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login"); return; }
        home = await Api.GetHomeAsync();
        renameValue = home?.Name ?? "";
    }

    void StartRename()
    {
        renameValue = home?.Name ?? "";
        renaming = true;
    }

    async Task ConfirmRenameAsync()
    {
        if (string.IsNullOrWhiteSpace(renameValue)) return;
        await Api.RenameHomeAsync(renameValue);
        home = await Api.GetHomeAsync();
        renaming = false;
    }

    async Task RefillFoodAsync(string cageId)
    {
        busyCages.Add(cageId);
        await Api.RefillFoodAsync(cageId);
        home = await Api.GetHomeAsync();
        busyCages.Remove(cageId);
    }

    async Task RefillWaterAsync(string cageId)
    {
        busyCages.Add(cageId);
        await Api.RefillWaterAsync(cageId);
        home = await Api.GetHomeAsync();
        busyCages.Remove(cageId);
    }

    bool IsBusy(string cageId) => busyCages.Contains(cageId);
}
