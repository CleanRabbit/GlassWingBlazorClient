@page "/"
@page "/home"
@inject GlassWingApiClient Api
@inject AuthStateService Auth
@inject NavigationManager Nav
@inject PlayerStateService PlayerState
@inject RewardToastService RewardToasts
@inject ProgressStateService ProgressState
@inject OpenMeteoClient Weather
@inject WelfareStateService Welfare

<PageTitle>Home — GlassWing</PageTitle>

@if (!loaded)
{
    <p class="text-muted">Loading...</p>
}
else if (loadError is not null)
{
    <div class="alert alert-danger">
        <strong>Failed to load home.</strong><br />
        <code>@loadError</code>
    </div>
    <button class="btn btn-outline-secondary mt-2" @onclick="RetryAsync">Retry</button>
}
else
{
    @if (gameSettings is not null)
    {
        <details class="mb-3">
            <summary class="text-muted small user-select-none" style="cursor:pointer">Server config</summary>
            <div class="d-flex flex-wrap gap-3 mt-2 small font-monospace">
                <span><span class="text-muted">Biological scale</span> @(gameSettings.BiologicalScale)×</span>
                <span><span class="text-muted">Food</span> @(gameSettings.FoodConsumptionScale)×</span>
                <span><span class="text-muted">Water</span> @(gameSettings.WaterConsumptionScale)×</span>
                <span><span class="text-muted">Training cooldown</span> @(gameSettings.TrainingCooldownScale)×</span>
                <span><span class="text-muted">Illness</span> @(gameSettings.IllnessProgressionScale)×</span>
            </div>
        </details>
    }

    @if (home!.Weather is { IsEnabled: true } weather)
    {
        <div class="card mb-3">
            <div class="card-body py-2 px-3">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="fw-semibold small">Weather</span>
                    @if (weather.TemperatureCelsius is { } temp && weather.RelativeHumidityPercent is { } humidity)
                    {
                        <span class="small">@temp.ToString("F1")°C · @humidity.ToString("F0")% RH</span>
                    }
                    else
                    {
                        <span class="small text-muted">No reading yet</span>
                    }
                    @if (weather.Conditions.TooWarm)
                    {
                        <span class="badge bg-warning text-dark">Too Warm</span>
                    }
                    @if (weather.Conditions.TooCold)
                    {
                        <span class="badge bg-info text-dark">Too Cold</span>
                    }
                    @if (weather.Conditions.TooHumid)
                    {
                        <span class="badge bg-warning text-dark">Too Humid</span>
                    }
                    @if (weather.Conditions.TooDry)
                    {
                        <span class="badge bg-info text-dark">Too Dry</span>
                    }
                    @if (!weather.Conditions.TooWarm && !weather.Conditions.TooCold && !weather.Conditions.TooHumid && !weather.Conditions.TooDry)
                    {
                        <span class="badge bg-light text-success border">Comfortable</span>
                    }
                </div>
                @{
                    var installedWeatherAccessories = new List<string>();
                    if (weather.Accessories.HasAirConditioning) installedWeatherAccessories.Add("Air Conditioning");
                    if (weather.Accessories.HasRadiator) installedWeatherAccessories.Add("Radiator");
                    if (weather.Accessories.HasDehumidifier) installedWeatherAccessories.Add("Dehumidifier");
                    if (weather.Accessories.HasHumidifier) installedWeatherAccessories.Add("Humidifier");
                }
                @if (installedWeatherAccessories.Count > 0)
                {
                    <div class="text-muted small mt-1">Installed: @string.Join(", ", installedWeatherAccessories)</div>
                }
            </div>
        </div>
    }

    @if (home!.LifeStageNotifications is { Length: > 0 })
    {
        @for (int i = 0; i < home.LifeStageNotifications.Length; i++)
        {
            var idx = i;
            if (!dismissedLifeStageNotifications.Contains(idx))
            {
                <div class="alert alert-success alert-dismissible mb-2 py-2" role="alert">
                    ✨ @home.LifeStageNotifications[idx].Message
                    <button type="button" class="btn-close" aria-label="Dismiss"
                            @onclick="() => dismissedLifeStageNotifications.Add(idx)"></button>
                </div>
            }
        }
    }

    @if (home!.DailyReward is { Available: true } dr)
    {
        <div class="alert alert-success d-flex justify-content-between align-items-center mb-2 py-2">
            <span>
                Daily reward ready — <strong>@FormatDailyReward(dr.Reward)</strong> (Day @dr.Day)
            </span>
            <button class="btn btn-sm btn-success" @onclick="ClaimDailyRewardAsync" disabled="@dailyRewardBusy">
                @(dailyRewardBusy ? "..." : "Claim")
            </button>
        </div>
    }

    @if (home!.AutoFills is { Length: > 0 })
    {
        @for (int i = 0; i < home.AutoFills.Length; i++)
        {
            var idx = i;
            var fill = home.AutoFills[idx];
            if (!dismissedAutoFills.Contains(idx))
            {
                var label = (fill.FoodRefilled, fill.WaterRefilled) switch
                {
                    (true, true)  => "food and water",
                    (true, false) => "food",
                    (false, true) => "water",
                    _             => "supplies"
                };
                <div class="alert alert-info alert-dismissible mb-2 py-2" role="alert">
                    Auto-filled @label in <strong>@fill.CageName</strong>.
                    <button type="button" class="btn-close" aria-label="Dismiss"
                            @onclick="() => dismissedAutoFills.Add(idx)"></button>
                </div>
            }
        }
    }

    @if (home!.VetTreatmentNotifications is { Length: > 0 })
    {
        @for (int i = 0; i < home.VetTreatmentNotifications.Length; i++)
        {
            var idx = i;
            if (!dismissedVetNotifications.Contains(idx))
            {
                <div class="alert alert-success alert-dismissible mb-2 py-2" role="alert">
                    🩺 @home.VetTreatmentNotifications[idx]
                    <button type="button" class="btn-close" aria-label="Dismiss"
                            @onclick="() => dismissedVetNotifications.Add(idx)"></button>
                </div>
            }
        }
    }

    @if (home!.MischiefNotifications is { Length: > 0 })
    {
        @for (int i = 0; i < home.MischiefNotifications.Length; i++)
        {
            var idx = i;
            if (!dismissedMischiefNotifications.Contains(idx))
            {
                <div class="alert alert-warning alert-dismissible mb-2 py-2" role="alert">
                    🐭 @home.MischiefNotifications[idx]
                    <button type="button" class="btn-close" aria-label="Dismiss"
                            @onclick="() => dismissedMischiefNotifications.Add(idx)"></button>
                </div>
            }
        }
    }

    @if (home!.SeasonalEvent is { Active: true } se)
    {
        <div class="alert alert-primary d-flex justify-content-between align-items-center mb-2 py-2">
            <span>
                <strong>@se.Name</strong> is on — @se.ChallengesCompleted / @se.ChallengesTotal challenges complete
                · @se.DaysRemaining day@(se.DaysRemaining != 1 ? "s" : "") left
            </span>
            <a class="btn btn-sm btn-outline-primary" href="/progress/seasonal">View</a>
        </div>
    }

    <div class="d-flex align-items-center gap-3 mb-4">
        @if (!renaming)
        {
            <h1 class="mb-0">@home!.Name</h1>
            <button class="btn btn-sm btn-outline-secondary" @onclick="StartRename">Rename</button>
        }
        @if (home!.Challenges is { } challenges)
        {
            <a href="/progress/challenges" class="text-decoration-none small text-muted">
                Challenges: @challenges.Completed/@challenges.Total this week
            </a>
        }
        @if (home!.CageSlots is { } slots)
        {
            <a href="/estate-agency" class="text-decoration-none small text-muted">
                Cages: @home.CagesOccupied/@slots
            </a>
        }
        @if (PlayerState.Currency.HasValue)
        {
            <span class="ms-auto badge bg-dark fs-6">@PlayerState.Currency.Value.ToString("N0") cr</span>
        }
        else
        {
            <input class="form-control w-auto" @bind="renameValue" />
            <button class="btn btn-sm btn-primary" @onclick="ConfirmRenameAsync">Save</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => renaming = false">Cancel</button>
        }
    </div>

    <div class="row g-3">
        @for (var i = 0; i < (home!.CageSlots ?? home.Cages.Length); i++)
        {
            var slotIndex = i;
            var cage = home.Cages.ElementAtOrDefault(slotIndex);
            <div class="col-md-6 col-xl-4">
                @if (cage is not null)
                {
                    <CageCard Cage="@cage" SlotIndex="@slotIndex" Home="@home" Catalogue="@catalogue" TrainingRegimes="@trainingRegimes"
                              OwnedCageDecorations="@ownedCageDecorations"
                              OnCageUpdated="ReplaceCage" OnDrawerItemConsumed="RemoveDrawerItem"
                              OnCageReplaced="OnCagePurchasedAsync" OnHomeChanged="OnCageMoveCompletedAsync" />
                }
                else
                {
                    <EmptyCageSlotCard SlotIndex="@slotIndex" CageTypes="@(catalogue?.Cages ?? [])"
                                       MaxCageTier="@home.MaxCageTier" OnCagePurchased="OnCagePurchasedAsync" />
                }
            </div>
        }
    </div>

    <h4 class="mt-4 mb-3">
        Home Accessories
        @if (home!.TotalAccessorySlots is { } totalAccessorySlots)
        {
            <span class="text-muted small ms-2">@(home.AccessoriesOccupied ?? 0)/@totalAccessorySlots</span>
        }
    </h4>
    <div class="row g-3">
        @{
            var emptyAccessorySlots = new HashSet<int>(home!.EmptyAccessorySlotIndices ?? []);
        }
        @for (var i = 0; i < (home.TotalAccessorySlots ?? 0); i++)
        {
            var idx = i;
            <div class="col-md-6 col-xl-4">
                @if (emptyAccessorySlots.Contains(idx))
                {
                    <EmptyAccessorySlotCard AnchorIndex="@idx" Catalogue="@catalogue" OnPurchased="OnAccessoryPurchasedAsync" />
                }
                else if (home.CarryCases?.FirstOrDefault(c => c.AnchorIndex == idx) is { } carryCase)
                {
                    <CarryCaseCard Info="@carryCase" />
                }
                else if (home.StorageDrawers?.FirstOrDefault(d => d.AnchorIndex == idx) is { } drawers)
                {
                    <StorageDrawersCard Info="@drawers" />
                }
                else if (home.FoodStorageBins?.FirstOrDefault(b => b.AnchorIndex == idx) is { } bin)
                {
                    <FoodStorageBinCard Info="@bin" />
                }
                else if (home.WeatherAccessories?.FirstOrDefault(w => w.AnchorIndex == idx) is { } weatherAcc)
                {
                    <WeatherAccessoryCard Info="@weatherAcc" Catalogue="@catalogue" />
                }
                else if (home.MedicationDevices?.FirstOrDefault(m => m.AnchorIndex == idx) is { } medDevice)
                {
                    <MedicationDeviceCard Info="@medDevice" Catalogue="@catalogue" />
                }
            </div>
        }
    </div>
}

@code {
    TrainingRegimeResponse[] trainingRegimes = [];

    HomeResponse? home;
    ShopCatalogueResponse? catalogue;
    GameSettingsResponse? gameSettings;
    bool loaded;
    string? loadError;
    bool renaming;
    string renameValue = "";
    readonly HashSet<int> dismissedAutoFills = [];
    readonly HashSet<int> dismissedLifeStageNotifications = [];
    readonly HashSet<int> dismissedVetNotifications = [];
    readonly HashSet<int> dismissedMischiefNotifications = [];
    bool dailyRewardBusy;
    CosmeticEntry[] ownedCageDecorations = [];

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login"); return; }
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        try
        {
            await ReportWeatherIfEnabledAsync();

            var homeTask      = Api.GetHomeAsync();
            var settingsTask  = Api.GetGameSettingsAsync();
            var catalogueTask = Api.GetShopCatalogueAsync();
            var regimesTask   = Api.GetTrainingRegimesAsync();
            var cosmeticsTask = Api.GetCosmeticsAsync();
            var (homeResult, settings) = (await homeTask, await settingsTask);
            catalogue        = await catalogueTask;
            trainingRegimes  = await regimesTask ?? [];
            var cosmetics    = await cosmeticsTask;
            ownedCageDecorations = cosmetics is null
                ? []
                : cosmetics.CageDecorations.Where(c => cosmetics.UnlockedCosmeticIds.Contains(c.Id)).ToArray();
            var (data, error) = homeResult;
            if (error == "HomeNotBootstrapped")
            {
                Nav.NavigateTo("/rats");
                return;
            }
            home         = data;
            loadError    = error;
            gameSettings = settings;
            renameValue  = home?.Name ?? "";

            if (home is not null)
            {
                ProgressState.ApplyHomeSnapshot(home);
                await ToastNewAchievementsAsync(home);
                if (home.Welfare is not null) Welfare.ApplyStatus(home.Welfare);
            }
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            loaded = true;
        }
    }

    // Best-effort only — any failure here (profile fetch, geocoding, forecast lookup, or the
    // report itself) just means neutral weather values stay in effect server-side. Must never
    // surface as a home-load error.
    async Task ReportWeatherIfEnabledAsync()
    {
        try
        {
            var profile = await Api.GetPlayerProfileAsync();
            if (profile is not { WeatherEnabled: true }) return;

            var coords = await Weather.GeocodeAsync(profile.Country, profile.State);
            if (coords is null) return;

            var reading = await Weather.GetCurrentWeatherAsync(coords.Value.Latitude, coords.Value.Longitude);
            if (reading is null) return;

            await Api.PostWeatherReadingAsync(reading.Value.TemperatureCelsius, reading.Value.RelativeHumidityPercent);
        }
        catch
        {
            // Neutral values remain in effect — see method summary.
        }
    }

    async Task ToastNewAchievementsAsync(HomeResponse homeData)
    {
        if (homeData.NewAchievements is not { Length: > 0 } newAchievements) return;

        var awardedCurrency = false;
        foreach (var a in newAchievements)
        {
            var toasted = RewardToasts.TryEnqueueAchievement(a.Id, new RewardToastItem(
                RewardToastKind.Achievement,
                "Achievement Unlocked!",
                a.Name,
                a.Reward.Currency,
                a.Reward.TitleId,
                a.Reward.CosmeticId));

            if (toasted && a.Reward.Currency.HasValue) awardedCurrency = true;
        }

        if (awardedCurrency)
        {
            var profile = await Api.GetPlayerProfileAsync();
            if (profile is not null) PlayerState.SetCurrency(profile.Currency);
        }
    }

    async Task ClaimDailyRewardAsync()
    {
        dailyRewardBusy = true;
        var (result, _) = await Api.ClaimDailyRewardAsync();
        if (result is not null)
        {
            // Currency amount is rendered separately via CurrencyAwarded below — don't repeat
            // it in Detail (that duplicated "+N cr" on screen the first time this was wired up).
            var detail = result.Reward.Type == "Currency" ? $"Day {result.Day}" : FormatDailyReward(result.Reward);
            if (result.CalendarWrapped) detail += " — you completed a full calendar cycle!";

            RewardToasts.Enqueue(new RewardToastItem(
                RewardToastKind.DailyReward,
                "Daily Reward Claimed!",
                detail,
                result.Reward.Type == "Currency" ? result.Reward.Amount : null));

            if (result.Reward.Type == "Currency")
            {
                var profile = await Api.GetPlayerProfileAsync();
                if (profile is not null) PlayerState.SetCurrency(profile.Currency);
            }
        }

        // Whether this succeeded or hit a soft 409 (already claimed, e.g. two open tabs), the
        // reward is not available again until tomorrow either way — patch that flag locally
        // instead of a full re-fetch (Task 29 §7 / Task 30 §3), and drop the nav badge the same
        // way ProgressDaily.razor already does after its own claim.
        if (home?.DailyReward is not null)
            home = home with { DailyReward = home.DailyReward with { Available = false } };
        ProgressState.ClearDailyReward();
        dailyRewardBusy = false;
    }

    static string FormatDailyReward(DailyRewardEntry reward) => reward.Type switch
    {
        "Currency"          => $"+{reward.Amount ?? 0:N0} cr",
        "AdoptionFeeWaiver" => "Adoption Fee Waiver",
        "EventEntryWaiver"  => "Event Entry Waiver",
        "Cosmetic"          => "Cosmetic Unlock",
        _                   => reward.Type
    };

    async Task RetryAsync()
    {
        loaded = false;
        loadError = null;
        home = null;
        StateHasChanged();
        await LoadAsync();
    }

    void StartRename()
    {
        renameValue = home?.Name ?? "";
        renaming = true;
    }

    async Task ConfirmRenameAsync()
    {
        if (string.IsNullOrWhiteSpace(renameValue)) return;
        var (result, _) = await Api.RenameHomeAsync(renameValue);
        if (result is not null && home is not null) home = home with { Name = result.Name };
        renaming = false;
    }

    // Replaces one cage in the local Cages array with the mutation response's updated cage —
    // preserves every other field on `home` (notifications, daily reward, welfare, etc.) instead
    // of clobbering them with a re-fetch (Task 29 §7 / Task 30 §3).
    void ReplaceCage(CageResponse updated)
    {
        if (home is null) return;
        home = home with { Cages = home.Cages.Select(c => c?.Id == updated.Id ? updated : c).ToArray() };
    }

    // Bowl/bottle/accessory installs pull an item out of a storage drawer server-side; the
    // widened cage-mutation responses don't carry the drawers' new state too (see worktree
    // report), so remove the consumed item from local drawer state here instead.
    void RemoveDrawerItem(string itemId)
    {
        if (home?.StorageDrawers is not { Length: > 0 }) return;
        home = home with
        {
            StorageDrawers = home.StorageDrawers.Select(d => !d.Items.Any(i => i.Id == itemId)
                ? d
                : d with { Items = d.Items.Where(i => i.Id != itemId).ToArray(), SlotsAvailable = d.SlotsAvailable + 1 }).ToArray()
        };
    }

    // A freshly-bought cage's CagePurchaseResponse is deliberately sparse (no Type/Food/Rats/etc.)
    // — there's no existing card to patch the way ReplaceCage does for a mutation on an already-
    // rendered cage, so a full reload is the simplest correct way to render it with everything
    // CageCard needs. Balance is patched immediately first for a snappy currency update.
    async Task OnCagePurchasedAsync(CagePurchaseResponse result)
    {
        PlayerState.SetCurrency(result.NewBalance);
        loaded = false;
        StateHasChanged();
        await LoadAsync();
    }

    // A rat move touches two cages at once (the source and the target) — a full reload is
    // simplest and matches the composition WelfareLockOverlay.razor's MergeCagesAsync already uses.
    async Task OnCageMoveCompletedAsync()
    {
        loaded = false;
        StateHasChanged();
        await LoadAsync();
    }

    // Same sparse-purchase-response reasoning as OnCagePurchasedAsync — none of the 5 buy
    // endpoints return enough to build a full card locally, so reload instead of patching.
    async Task OnAccessoryPurchasedAsync(decimal newBalance)
    {
        PlayerState.SetCurrency(newBalance);
        loaded = false;
        StateHasChanged();
        await LoadAsync();
    }
}
