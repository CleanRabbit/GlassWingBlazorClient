@page "/login"
@using System.ComponentModel.DataAnnotations
@inject GlassWingApiClient Api
@inject AuthStateService Auth
@inject NavigationManager Nav

<PageTitle>Login — GlassWing</PageTitle>
<h1>Login</h1>

@if (Auth.IsDevBypass)
{
    <div class="alert alert-warning">
        Dev Bypass is active — you are already authenticated.
        <a href="/home" class="alert-link ms-2">Go to Home</a>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm Model="model" OnValidSubmit="SubmitAsync">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <InputText class="form-control" @bind-Value="model.Email" />
                    <ValidationMessage For="@(() => model.Email)" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <InputText class="form-control" type="password" @bind-Value="model.Password" />
                    <ValidationMessage For="@(() => model.Password)" />
                </div>
                @if (error is not null)
                {
                    <div class="alert alert-danger">@error</div>
                }
                <button class="btn btn-primary me-2" type="submit" disabled="@submitting">
                    @(submitting ? "Logging in..." : "Login")
                </button>
                <a href="/register">Register</a>
            </EditForm>
        </div>
    </div>
}

@code {
    readonly LoginModel model = new();
    string? error;
    bool submitting;

    protected override void OnInitialized()
    {
        if (Auth.IsAuthenticated) Nav.NavigateTo("/home");
    }

    async Task SubmitAsync()
    {
        submitting = true;
        error = null;
        var result = await Api.LoginAsync(model.Email, model.Password);
        if (result is not null)
        {
            Auth.Token = result.Token;
            Auth.PlayerId = result.PlayerId;
            Auth.Username = result.Username;
            Nav.NavigateTo("/home");
        }
        else
        {
            error = "Login failed. Check your credentials.";
            submitting = false;
        }
    }

    class LoginModel
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = "";
    }
}
