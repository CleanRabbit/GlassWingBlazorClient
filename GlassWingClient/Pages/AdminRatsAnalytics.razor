@page "/admin/rats/analytics"
@inject GlassWingApiClient Api
@inject AuthStateService Auth
@inject NavigationManager Nav

<PageTitle>Rats Analytics — Admin — GlassWing</PageTitle>

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
        <li class="breadcrumb-item active">Rats Analytics</li>
    </ol>
</nav>

<h1 class="mb-1">Rats Analytics</h1>
<p class="text-muted">
    Aggregate snapshot across every rat in the game, computed live. A starting point for future
    graphing — for now just the raw numbers.
</p>

@if (!loaded)
{
    <p>Loading...</p>
}
else if (loadError is not null)
{
    <div class="alert alert-danger">@loadError</div>
}
else
{
    <div class="row g-3 mb-4">
        <StatTile Label="Total Rats" Value="@data!.TotalRats.ToString("N0")" />
        <StatTile Label="Retired" Value="@data!.RetiredCount.ToString("N0")" />
        <StatTile Label="Pregnant" Value="@data!.PregnantCount.ToString("N0")" />
        <StatTile Label="Nursing" Value="@data!.NursingCount.ToString("N0")" />
    </div>

    <h4 class="mt-4">Population &amp; Lifecycle</h4>
    <div class="row g-3 mb-2">
        <div class="col-md-4"><DistributionCard Title="By Life Stage" Values="data!.ByLifeStage" /></div>
        <div class="col-md-4"><DistributionCard Title="By Sex" Values="data!.BySex" /></div>
        <div class="col-md-4"><DistributionCard Title="By Generation" Values="data!.ByGeneration" /></div>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-md-4"><SummaryStatCard Title="Age (days)" Stat="data!.AgeDays" /></div>
    </div>

    <h4 class="mt-4">Ability &amp; Potential</h4>
    <div class="mb-4">
        <table class="table table-sm">
            <thead><tr><th></th><th>Min</th><th>Max</th><th>Average</th></tr></thead>
            <tbody>
                @foreach (var (label, stat) in new[]
                {
                    ("Sprint Ability", data!.SprintAbility),
                    ("Agility Ability", data!.AgilityAbility),
                    ("Endurance Ability", data!.EnduranceAbility),
                    ("Sprint Potential", data!.SprintPotential),
                    ("Agility Potential", data!.AgilityPotential),
                    ("Endurance Potential", data!.EndurancePotential),
                })
                {
                    <tr>
                        <td>@label</td>
                        <td>@stat.Min.ToString("N1")</td>
                        <td>@stat.Max.ToString("N1")</td>
                        <td>@stat.Average.ToString("N1")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h4 class="mt-4">Health &amp; Stress</h4>
    <div class="row g-3 mb-2">
        <StatTile Label="Critical" Value="@data!.CriticalCount.ToString("N0")" />
        <StatTile Label="Actively Ill" Value="@data!.ActiveIllnessCount.ToString("N0")" />
        <StatTile Label="Hungry Now" Value="@data!.HungryCount.ToString("N0")" />
        <StatTile Label="Thirsty Now" Value="@data!.ThirstyCount.ToString("N0")" />
    </div>
    <div class="row g-3 mb-2">
        <div class="col-md-4"><DistributionCard Title="By Vitality" Values="data!.ByVitality" /></div>
        <div class="col-md-4"><DistributionCard Title="By Diet Quality" Values="data!.ByDietQuality" /></div>
        <div class="col-md-4"><SummaryStatCard Title="Weight (g)" Stat="data!.WeightGrams" /></div>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-md-6"><DistributionCard Title="Illness Frequency" Values="data!.IllnessFrequency" /></div>
        <div class="col-md-6"><DistributionCard Title="Stressor Frequency" Values="data!.StressorFrequency" /></div>
    </div>

    <h4 class="mt-4">Traits</h4>
    <p class="text-muted small">
        Only environmentally-triggered traits stored on the rat — genotype-derived traits
        (Bold/Shy/Curious/etc.) aren't included yet.
    </p>
    <div class="row g-3 mb-4">
        <div class="col-md-6"><DistributionCard Title="Trait Frequency" Values="data!.TraitFrequency" /></div>
    </div>
}

@code {
    bool loaded;
    string? loadError;
    AdminRatAnalyticsResponse? data;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAdmin) { Nav.NavigateTo("/home"); return; }

        var response = await Api.AdminGetRatAnalyticsAsync();
        loaded = true;
        if (response is null) { loadError = "Failed to load rat analytics."; return; }
        data = response;
    }
}
