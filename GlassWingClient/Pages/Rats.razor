@page "/rats"
@inject GlassWingApiClient Api
@inject AuthStateService Auth
@inject NavigationManager Nav

<PageTitle>Rats — GlassWing</PageTitle>
<h1>My Rats</h1>

@if (rats is null)
{
    <p>Loading...</p>
}
else if (rats.Length == 0)
{
    <p class="text-muted">You don't have any rats yet.</p>
    <button class="btn btn-primary" @onclick="CreateStarterAsync" disabled="@creating">
        @(creating ? "Creating..." : "Create Starter Rat")
    </button>
}
else
{
    <div class="mb-3">
        <button class="btn btn-outline-primary btn-sm" @onclick="CreateStarterAsync" disabled="@creating">
            @(creating ? "Creating..." : "Add Another Rat")
        </button>
    </div>
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Name</th>
                <th>Sex</th>
                <th>Sprint</th>
                <th>Agility</th>
                <th>Endurance</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var rat in rats.OrderBy(r => r.IsRetired))
            {
                <tr @onclick="() => OpenRat(rat.Id)" style="cursor: pointer" class="@(rat.IsRetired ? "text-muted" : "")">
                    <td>
                        @rat.Name
                        @if (rat.IsRetired)
                        {
                            <span class="badge bg-dark ms-1">Retired</span>
                        }
                        @if (rat.IsPregnant)
                        {
                            <span class="badge bg-info text-dark ms-1">Pregnant</span>
                        }
                    </td>
                    <td>@rat.Sex</td>
                    <td>@rat.SprintAbility.ToString("F1")</td>
                    <td>@rat.AgilityAbility.ToString("F1")</td>
                    <td>@rat.EnduranceAbility.ToString("F1")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    RatRosterResponse[]? rats;
    bool creating;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login"); return; }
        rats = await Api.ListRatsAsync();
    }

    void OpenRat(string id) => Nav.NavigateTo($"/rats/{id}");

    async Task CreateStarterAsync()
    {
        creating = true;
        var rat = await Api.CreateStarterAsync();
        if (rat is not null)
            Nav.NavigateTo($"/rats/{rat.Id}");
        creating = false;
    }

}
