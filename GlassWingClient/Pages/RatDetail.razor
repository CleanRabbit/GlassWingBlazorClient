    async Task LoadTrickCatalogueAsync() => trickCatalogue = await Api.GetTrickCatalogueAsync();

    string TrickName(string trickId) =>
        trickCatalogue?.Categories.SelectMany(c => c.Tricks).FirstOrDefault(t => t.Id == trickId)?.Name ?? trickId;

    static int BondingPct(BondingInfo b) => b.Capacity <= 0 ? 0 : (int)Math.Min(100, b.CurrentLevel / b.Capacity * 100);

    void StartTrickPicker()
    {
        trickPickerValue = rat?.CurrentTrickTraining?.TrickId ?? "";
        trickError = null;
        trickPickerOpen = true;
