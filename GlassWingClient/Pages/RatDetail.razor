    RenderFragment IllnessCard(ActiveIllness illness) => __builder =>
    {
        var hasVetZone = illness.IsDiagnosed;
        var hasOtcZone = illness.OtcCureProgress > 0 || illness.OtcCriticalBufferHours > 0;

        <div class="border rounded p-2 mb-2 small">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="fw-bold">@(illness.IsDiagnosed ? illness.Name : "Unknown illness")</div>
                    <div class="text-muted">Unwell since @illness.StartedAt.ToString("dd MMM yyyy")</div>
                </div>
                @if (illness.IsDiagnosed && illness.Category is not null)
                {
                    <span class="badge bg-secondary">@illness.Category</span>
                }
            </div>

            @if (hasVetZone)
            {
                <hr class="my-2" />
                <div>
                    <span class="text-primary fw-semibold">🩺 Vet:</span>
                    @if (!illness.TreatmentApplied)
                    {
                        if (illness.TreatmentType == "None")
                        {
                            <span class="text-muted">No vet-purchasable treatment for this illness.</span>
                        }
                        else
                        {
                            <span>@illness.TreatmentType treatment available</span>
                            <button class="btn btn-sm btn-outline-primary ms-2"
                                    disabled="@vetActionBusy.Contains(illness.IllnessId!)"
                                    @onclick="() => TreatAsync(illness.IllnessId!)">
                                Treat
                            </button>
                        }
                    }
                    else if (illness.TreatmentType == "Course")
                    {
                        <div>Dose @illness.DosesAdministered / @illness.DoseCount</div>
                        <div class="progress mb-1" style="height:6px">
                            <div class="progress-bar bg-primary" style="width:@(CoursePct(illness))%"></div>
                        </div>
                        <button class="btn btn-sm btn-outline-primary"
                                disabled="@(!illness.CanDoseToday.GetValueOrDefault() || vetActionBusy.Contains(illness.IllnessId!))"
                                @onclick="() => DoseAsync(illness.IllnessId!)">
                            Give today's dose
                        </button>
                    }
                    else
                    {
                        <span class="text-muted">
                            Recovering@(illness.TreatmentRecoveryHours is { } h ? $" — ready in ~{h:F0}h" : "…")
                        </span>
                    }
                </div>
            }

            @if (hasOtcZone)
            {
                <hr class="my-2" />
                <div>
                    <span class="text-success fw-semibold">🌿 OTC:</span>
                    @if (illness.OtcCureProgress > 0)
                    {
                        <div>Cure progress</div>
                        <div class="progress mb-1" style="height:6px">
                            <div class="progress-bar bg-success" style="width:@(illness.OtcCureProgress.ToString("F0"))%"></div>
                        </div>
                    }
                    @if (illness.OtcCriticalBufferHours > 0)
                    {
                        <div class="text-muted">Critical buffer: +@illness.OtcCriticalBufferHours.ToString("F0")h</div>
                    }
                </div>
            }
        </div>
    };

