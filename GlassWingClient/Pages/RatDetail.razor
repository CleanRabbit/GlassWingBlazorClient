    async Task TreatAsync(string illnessId)
    {
        vetActionBusy.Add(illnessId);
        vetMessage = null;
        var (updated, error) = await Api.VetTreatAsync(Id, illnessId);
        if (updated is not null)
        {
            rat = updated;
        }
        else
        {
            vetSuccess = false;
            vetMessage = error ?? "Failed to start treatment.";
        }
        vetActionBusy.Remove(illnessId);
    }

    async Task DoseAsync(string illnessId)
    {
        vetActionBusy.Add(illnessId);
        vetMessage = null;
        var illnessBefore = rat?.HealthState?.ActiveIllnesses?.FirstOrDefault(i => i.IllnessId == illnessId);
        var (updated, error) = await Api.VetDoseAsync(Id, illnessId);
        if (updated is not null)
        {
            var stillPresent = updated.HealthState?.ActiveIllnesses?.Any(i => i.IllnessId == illnessId) == true;
            rat = updated;
            if (!stillPresent && illnessBefore is not null)
            {
                vetSuccess = true;
                vetMessage = $"{rat.Name} has recovered from {illnessBefore.Name}.";
            }
        }
        else
        {
            vetSuccess = false;
            vetMessage = error ?? "Failed to administer dose.";
        }
        vetActionBusy.Remove(illnessId);
    }

    static int CoursePct(ActiveIllness illness) =>
        illness.DoseCount is > 0 ? (int)Math.Min(100, (illness.DosesAdministered ?? 0) * 100.0 / illness.DoseCount.Value) : 0;

    bool IsOnCooldown(string medicationId) =>
        rat?.OtcMedicationCooldowns?.Any(c => c.MedicationId == medicationId && c.AvailableAt > DateTime.UtcNow) == true;

    DateTime? CooldownUntil(string medicationId) =>
        rat?.OtcMedicationCooldowns?.FirstOrDefault(c => c.MedicationId == medicationId)?.AvailableAt;

    static string FormatCountdown(DateTime until)
    {
        var remaining = until - DateTime.UtcNow;
        if (remaining <= TimeSpan.Zero) return "Ready";
        return remaining.TotalHours >= 1
            ? $"Ready in {(int)remaining.TotalHours}h {remaining.Minutes}m"
            : $"Ready in {remaining.Minutes}m";
    }

