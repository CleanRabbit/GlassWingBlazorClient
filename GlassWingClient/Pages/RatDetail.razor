@page "/rats/{Id}"
@implements IDisposable
@inject GlassWingApiClient Api
@inject AuthStateService Auth
@inject NavigationManager Nav
@inject PlayerStateService PlayerState
@inject RewardToastService RewardToasts
@inject WelfareStateService Welfare

<PageTitle>@(rat?.Name ?? "Rat") — GlassWing</PageTitle>

@if (!loaded)
{
    <p>Loading...</p>
}
else if (rat is null)
{
    <div class="alert alert-danger">Rat not found.</div>
}
else
{
    @if (isPublicView)
    {
        <div class="alert alert-info py-2">Viewing another player's rat — read-only.</div>
    }
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/rats">Rats</a></li>
            <li class="breadcrumb-item active">@rat.Name</li>
        </ol>
    </nav>

    @if (!rat.IsRetired && DaysUntilRetirement() is { } daysLeft)
    {
        @if (settings?.RetirementWarningLateDays is { } lateDays && daysLeft <= lateDays)
        {
            <div class="alert alert-danger py-2">@rat.Name retires in less than a day.</div>
        }
        else if (settings?.RetirementWarningEarlyDays is { } earlyDays && daysLeft <= earlyDays)
        {
            <div class="alert alert-warning py-2">@rat.Name will retire in about @Math.Ceiling(daysLeft) day@(Math.Ceiling(daysLeft) == 1 ? "" : "s").</div>
        }
    }

    <div class="d-flex align-items-center gap-3 mb-4">
        @if (rat.IsRetired)
        {
            <h1 class="mb-0">@rat.Name</h1>
            <span class="badge bg-dark">Retired</span>
            <span class="text-muted">@RetirementReasonLabel(rat.RetirementReason) @(rat.RetiredAt is { } ra ? $"· {ra:dd MMM yyyy}" : "")</span>
        }
        else if (!renaming)
        {
            <h1 class="mb-0">@rat.Name</h1>
            <span class="badge bg-info text-dark">@rat.LifeStage</span>
            @if (rat.IsNursing)
            {
                <span class="badge bg-warning text-dark" title="Nursing — locked to this cage; cannot train, breed, enter events, or be moved/sold/listed">🔒 Nursing</span>
            }
            else if (rat.IsProtective)
            {
                <span class="badge bg-warning text-dark" title="Protective mother — free-roam training unavailable too">🛡️ Protective</span>
            }
            @if (rat.PlaySession?.SolitudeActive == true)
            {
                <span class="badge bg-warning text-dark" title="Hasn't been played with recently">Lonely</span>
            }
            @if (rat.LifeStage != "Weening" && !isPublicView)
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick="StartRename">Rename</button>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => showRetireConfirm = true">Retire</button>
            }
        }
        else
        {
            <input class="form-control w-auto" @bind="newName" />
            <button class="btn btn-sm btn-primary" @onclick="ConfirmRenameAsync">Save</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => renaming = false">Cancel</button>
        }
    </div>

    @if (rat.LifeStage == "Weening")
    {
        <div class="card" style="max-width:400px">
            <div class="card-body">
                <p class="mb-1">Born @rat.DateOfBirth.ToString("dd MMM yyyy")</p>
                @if (motherName is not null)
                {
                    <p class="mb-1">Mother: <a href="/rats/@rat.MotherId">@motherName</a></p>
                }
                <p class="text-muted small mb-0">
                    Too young to show full details. Check back once @rat.Name reaches the Infant stage.
                </p>
            </div>
        </div>
    }
    else
    {
    <div class="row g-3 mb-3">

        @* Ability *@
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="card-subtitle mb-3 text-muted">Ability</h6>
                    @foreach (var (label, ability, potential) in new[] {
                        ("Sprint", rat.SprintAbility, rat.SprintPotential),
                        ("Agility", rat.AgilityAbility, rat.AgilityPotential),
                        ("Endurance", rat.EnduranceAbility, rat.EndurancePotential) })
                    {
                        var pct = potential > 0 ? ability / potential * 100 : 0;
                        <div class="d-flex justify-content-between mb-1">
                            <span class="small text-muted">@label</span>
                            <span class="small">@ability.ToString("F1") / @potential</span>
                        </div>
                        <div class="progress mb-2" style="height:8px">
                            <div class="progress-bar bg-primary" style="width:@(pct.ToString("F0"))%"></div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Health *@
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="card-subtitle mb-3 text-muted">Health</h6>
                    @if (rat.HealthState is { } h)
                    {
                        <div class="mb-3">
                            <span class="badge @VitalityBadgeClass(h.Vitality) fs-6">@(h.Vitality ?? "Unknown")</span>
                        </div>
                        <table class="table table-sm mb-3">
                            <tbody>
                                <tr><th>Weight</th><td>@h.WeightGrams.ToString("F1")g</td></tr>
                                <tr><th>Length</th><td>@h.BodyLengthCm.ToString("F1")cm</td></tr>
                            </tbody>
                        </table>

                        @if (h.ActiveIllnesses?.Any(i => !i.IsDiagnosed) == true)
                        {
                            <div class="alert alert-warning d-flex justify-content-between align-items-center py-2 mb-2 small">
                                <span>Undiagnosed illness detected.</span>
                                <button class="btn btn-sm btn-primary" @onclick="VetVisitAsync" disabled="@vetBusy">
                                    @(vetBusy ? "..." : $"Take to vet ({settings?.VetDiagnosisFee ?? 15} cr)")
                                </button>
                            </div>
                        }
                        @if (vetMessage is not null)
                        {
                            <div class="alert @(vetSuccess ? "alert-success" : "alert-danger") py-2 mb-2 small">@vetMessage</div>
                        }

                        @if (rat.OtcProtections is { Length: > 0 } protections)
                        {
                            <div class="mb-2">
                                @foreach (var p in protections)
                                {
                                    <div class="small text-success">
                                        🌿 @p.Category protection active (×@p.Factor.ToString("F1")) — expires @p.ExpiresAt.ToLocalTime().ToString("dd MMM HH:mm")
                                    </div>
                                }
                            </div>
                        }

                        var devices = home?.MedicationDevices ?? [];
                        var doseGroups = (home?.StorageDrawers ?? []).SelectMany(d => d.Items)
                            .Where(i => i.Kind == "Medication")
                            .GroupBy(i => i.TypeId)
                            .ToArray();
                        @if (devices.Length > 0 || doseGroups.Length > 0)
                        {
                            <div class="mb-2 d-flex flex-wrap gap-1">
                                @foreach (var dev in devices)
                                {
                                    var med = catalogue?.Medications?.FirstOrDefault(m => m.Id == dev.TypeId);
                                    var onCooldown = IsOnCooldown(dev.TypeId);
                                    <button class="btn btn-sm btn-outline-success"
                                            disabled="@(onCooldown || otcBusy)"
                                            @onclick="() => UseDeviceAsync(dev.TypeId)">
                                        @(onCooldown ? $"{med?.Name ?? dev.TypeId} — {FormatCountdown(CooldownUntil(dev.TypeId)!.Value)}" : $"Use {med?.Name ?? dev.TypeId}")
                                    </button>
                                }
                                @foreach (var group in doseGroups)
                                {
                                    var med = catalogue?.Medications?.FirstOrDefault(m => m.Id == group.Key);
                                    var onCooldown = IsOnCooldown(group.Key);
                                    var firstItemId = group.First().Id;
                                    <button class="btn btn-sm btn-outline-success"
                                            disabled="@(onCooldown || otcBusy)"
                                            @onclick="() => AdministerDoseAsync(firstItemId)">
                                        @(onCooldown ? $"{med?.Name ?? group.Key} — {FormatCountdown(CooldownUntil(group.Key)!.Value)}" : $"Administer {med?.Name ?? group.Key} (×{group.Count()})")
                                    </button>
                                }
                            </div>
                        }
                        @if (otcMessage is not null)
                        {
                            <div class="alert alert-warning py-2 mb-2 small">@otcMessage</div>
                        }

                        @if (h.ActiveIllnesses is { Length: > 0 })
                        {
                            <h6 class="text-danger mb-2">Active Illnesses</h6>
                            @foreach (var illness in h.ActiveIllnesses)
                            {
                                @IllnessCard(illness)
                            }
                        }
                        else
                        {
                            <small class="text-muted">No active illnesses</small>
                        }
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </div>
            </div>
        </div>

        @* Personality *@
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="card-subtitle mb-3 text-muted">Personality</h6>
                    @if (rat.Traits is { Length: > 0 })
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var trait in rat.Traits)
                            {
                                <span class="badge bg-secondary" title="@TraitDescription(trait)">@trait</span>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="text-muted small">No notable traits</span>
                    }
                </div>
            </div>
        </div>

    </div>

    @* Appearance *@
    @if (rat.Phenotype is { Coat: { } coat } phenotype)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h6 class="card-subtitle mb-3 text-muted">Appearance</h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <table class="table table-sm mb-0">
                            <tbody>
                                <tr>
                                    <th>Description</th>
                                    <td>@CoatDescription(coat)</td>
                                </tr>
                                <tr><th>Eyes</th><td>@(coat.EyeColor ?? "—")</td></tr>
                                <tr><th>Ears</th><td>@(coat.EarType ?? "—")</td></tr>
                                @if (coat.Pattern == "Hooded" && coat.HoodQuality is not null)
                                {
                                    <tr><th>Hood Quality</th><td>@coat.HoodQuality</td></tr>
                                }
                                @if (coat.PointColor is not null)
                                {
                                    <tr><th>Point Colour</th><td>@coat.PointColor</td></tr>
                                }
                                @if (phenotype.Morphology is { } morph)
                                {
                                    <tr><th>Sex</th><td>@(morph.Sex ?? "—")</td></tr>
                                    <tr><th>Size</th><td>@morph.BodySize / 100</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <p class="text-muted small mb-2">Markings</p>
                        <div class="d-flex flex-wrap gap-2">
                            @if (coat.HasBlaze)         { <span class="badge bg-secondary">Blaze</span> }
                            @if (coat.IsRoan)           { <span class="badge bg-secondary">Roan</span> }
                            @if (coat.IsDownunder)      { <span class="badge bg-secondary">Downunder</span> }
                            @if (coat.IsDownunderHomozygous) { <span class="badge bg-secondary">Downunder (HZ)</span> }
                            @if (coat.Silvering == "Light")  { <span class="badge bg-secondary">Light Silvering</span> }
                            @if (coat.Silvering == "Heavy")  { <span class="badge bg-secondary">Heavy Silvering</span> }
                            @if (coat.Pearl == "Light")      { <span class="badge bg-secondary">Light Pearl</span> }
                            @if (coat.Pearl == "Heavy")      { <span class="badge bg-secondary">Heavy Pearl</span> }
                            @if (coat.HasWhiteFeet)          { <span class="badge bg-secondary">White Feet</span> }
                            @if (coat.IsHuskyCarrier)        { <span class="badge bg-secondary">Husky Carrier@(coat.IsBandedHusky ? " (Banded)" : "")</span> }
                            @if (!coat.HasBlaze && !coat.IsRoan && !coat.IsDownunder && !coat.HasWhiteFeet && !coat.IsHuskyCarrier
                                 && coat.Silvering is null or "None" && coat.Pearl is null or "None")
                            {
                                <span class="text-muted small">None</span>
                            }
                        </div>
                        @if (!isPublicView)
                        {
                            <div class="mt-3">
                                <p class="text-muted small mb-1">Accessory</p>
                                <select class="form-select form-select-sm d-inline-block" style="max-width:200px"
                                        value="@(rat.ActiveCosmeticId ?? "")"
                                        @onchange="e => SetRatCosmeticAsync(e.Value?.ToString())"
                                        disabled="@cosmeticBusy">
                                    <option value="">— none —</option>
                                    @foreach (var acc in ownedRatAccessories)
                                    {
                                        <option value="@acc.Id">@acc.Name</option>
                                    }
                                </select>
                                @if (cosmeticError is not null)
                                {
                                    <div class="text-danger small mt-1">@cosmeticError</div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @* Lineage (Task 13) *@
    @if (rat.Ancestry is { Father: not null } or { Mother: not null })
    {
        <div class="card mb-4">
            <div class="card-body">
                <h6 class="card-subtitle mb-3 text-muted">Lineage</h6>
                <div class="d-flex gap-4 flex-wrap">
                    <div>
                        <div class="text-muted small mb-1">Father</div>
                        @AncestorNodeView(rat.Ancestry.Father, "father", 1)
                    </div>
                    <div>
                        <div class="text-muted small mb-1">Mother</div>
                        @AncestorNodeView(rat.Ancestry.Mother, "mother", 1)
                    </div>
                </div>
            </div>
        </div>
    }

    @* Training *@
    @if (!rat.IsRetired && rat.LifeStage != "Infant" && !rat.IsNursing && !isPublicView)
    {
        <h5>Training</h5>
        <div class="d-flex gap-2 mb-2">
            <button class="btn btn-outline-primary" @onclick='() => TrainAsync("Sprint")' disabled="@training">Sprint</button>
            <button class="btn btn-outline-primary" @onclick='() => TrainAsync("Agility")' disabled="@training">Agility</button>
            <button class="btn btn-outline-primary" @onclick='() => TrainAsync("Endurance")' disabled="@training">Endurance</button>
        </div>
        @if (trainMessage is not null)
        {
            <div class="alert @(trainSuccess ? "alert-success" : "alert-warning") py-2">@trainMessage</div>
        }
    }

    @* Tricks *@
    @if (!rat.IsRetired && rat.LifeStage != "Infant" && !rat.IsNursing)
    {
        <h5 class="mt-4">Tricks</h5>
        <div class="card mb-2">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <p class="text-muted small mb-2">Learned</p>
                        @if (rat.TricksLearned is { Length: > 0 })
                        {
                            <div class="d-flex flex-wrap gap-1 mb-3">
                                @foreach (var trick in rat.TricksLearned)
                                {
                                    <span class="badge bg-success">@TrickName(trick)</span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-muted small">None yet</span>
                        }

                        @if (rat.Bonding is { } bonding)
                        {
                            <p class="text-muted small mb-1">Bonding</p>
                            <div class="d-flex justify-content-between small mb-1">
                                <span>@bonding.CurrentLevel.ToString("F1") / @bonding.Capacity.ToString("F1")</span>
                            </div>
                            <div class="progress" style="height:8px">
                                <div class="progress-bar bg-info" style="width:@(BondingPct(bonding))%"></div>
                            </div>
                        }
                    </div>

                    @if (!isPublicView)
                    {
                    <div class="col-md-6">
                        <p class="text-muted small mb-2">Training</p>
                        @if (!trickPickerOpen)
                        {
                            <p class="mb-1">
                                Currently training:
                                @if (rat.CurrentTrickTraining is { } training)
                                {
                                    <strong>@TrickName(training.TrickId) (@training.Progress.ToString("F0")%)</strong>
                                }
                                else
                                {
                                    <strong>None</strong>
                                }
                                <button class="btn btn-link btn-sm p-0 ms-1" @onclick="StartTrickPicker">Change</button>
                            </p>
                        }
                        else
                        {
                            <select class="form-select form-select-sm mb-2" @bind="trickPickerValue">
                                <option value="">None</option>
                                @foreach (var group in trickCatalogue?.Categories ?? [])
                                {
                                    <optgroup label="@group.Category">
                                        @foreach (var trick in group.Tricks)
                                        {
                                            var myStatus = trick.Rats.FirstOrDefault(r => r.RatId == Id);
                                            if (myStatus is null || myStatus.Status == "Learned") { continue; }
                                            var locked = myStatus.Status == "Locked";
                                            <option value="@trick.Id" disabled="@locked">
                                                @trick.Name@(locked ? $" (requires {trick.AptitudeThreshold}, has {myStatus.Aptitude})" : "")
                                            </option>
                                        }
                                    </optgroup>
                                }
                            </select>
                            <div class="d-flex gap-2 mb-1">
                                <button class="btn btn-primary btn-sm" disabled="@trickBusy" @onclick="ConfirmTrickTrainingAsync">
                                    @(trickBusy ? "..." : "Set")
                                </button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => trickPickerOpen = false">Cancel</button>
                            </div>
                        }
                        @if (trickError is not null)
                        {
                            <div class="text-danger small mb-1">@trickError</div>
                        }

                        @if (rat.CurrentTrickTraining is null)
                        {
                            <p class="text-muted small mt-3 mb-0">Assign a trick above to start a play session.</p>
                        }
                        else
                        {
                            <div class="mt-3">
                                <p class="text-muted small mb-1">
                                    Today's active progress: @UsedProgress().ToString("F1") / @((settings?.MaxActiveProgressPerRatPerDay ?? 0).ToString("F1")) used
                                </p>
                                @if (!playSessionActive)
                                {
                                    <button class="btn btn-outline-primary btn-sm" @onclick="StartPlaySession" disabled="@playSessionBusy">
                                        Start Play Session
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-primary btn-sm" @onclick="EndPlaySessionAsync" disabled="@(playSessionBusy || elapsedSeconds == 0)">
                                        End Session (@FormatElapsed())
                                    </button>
                                    @if (elapsedSeconds >= (settings?.MaxPlaySessionSeconds ?? 600))
                                    {
                                        <span class="badge bg-secondary ms-2">Max session length reached</span>
                                    }
                                }
                                @if (playSessionMessage is not null)
                                {
                                    <div class="alert @(playSessionSuccess ? "alert-success" : "alert-warning") py-2 mt-2 mb-0">@playSessionMessage</div>
                                }
                            </div>
                        }
                    </div>
                    }
                </div>
            </div>
        </div>
    }

    @* Breeding *@
    @if (!rat.IsRetired && rat.LifeStage == "Adult" && !rat.IsNursing && !isPublicView)
    {
        <h5 class="mt-4">Breeding</h5>
        @if (rat.Sex == "Male")
        {
            <p class="text-muted small">This rat can sire litters. Start breeding from the mother's page.</p>
        }
        else if (rat.IsPregnant)
        {
            <p class="mb-1">
                🐭 Pregnant — due @(rat.DueAt is { } due ? $"in {Math.Max(0, (due - DateTime.UtcNow).Days)} day{(Math.Max(0, (due - DateTime.UtcNow).Days) == 1 ? "" : "s")}" : "soon")
                @if (fatherName is not null)
                {
                    <text>(sired by @fatherName)</text>
                }
            </p>
        }
        else
        {
            <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
                <select class="form-select form-select-sm" style="max-width: 220px" @bind="selectedMateId">
                    <option value="">— pick a mate —</option>
                    @foreach (var m in maleRats)
                    {
                        <option value="@m.Id">@m.Name</option>
                    }
                </select>
                <button class="btn btn-outline-primary btn-sm" @onclick="BreedAsync" disabled="@(string.IsNullOrEmpty(selectedMateId) || breeding)">
                    @(breeding ? "Breeding..." : "Breed")
                </button>
            </div>
            @if (breedMessage is not null)
            {
                <div class="alert alert-danger py-2">@breedMessage</div>
            }
        }
    }

    @* Marketplace *@
    @if (!rat.IsRetired && !rat.IsNursing && rat.HealthState?.Vitality == "Healthy")
    {
        <h5 class="mt-4">Marketplace</h5>
        @if (!listingFormOpen)
        {
            <button class="btn btn-outline-secondary" @onclick="() => listingFormOpen = true">List on Marketplace</button>
        }
        else
        {
            <div class="card" style="max-width:400px">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Asking Price (cr)</label>
                        <input type="number" class="form-control" @bind="listingPrice" min="1" />
                    </div>
                    @if (settings?.MarketplaceListingFee is { } fee || settings?.MarketplaceTransactionFeePercent is { } txPct)
                    {
                        <div class="mb-3 small text-muted">
                            @if (settings.MarketplaceListingFee is { } f)
                            {
                                <div>Listing fee: @f.ToString("N0") cr (charged now)</div>
                            }
                            @if (settings.MarketplaceTransactionFeePercent is { } p)
                            {
                                <div>Transaction fee: @((p * 100).ToString("F0"))% deducted on sale</div>
                            }
                        </div>
                    }
                    @if (listingMessage is not null)
                    {
                        <div class="alert @(listingSuccess ? "alert-success" : "alert-danger") py-2">@listingMessage</div>
                    }
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary" @onclick="CreateListingAsync" disabled="@listingBusy">
                            @(listingBusy ? "Listing..." : "List for Sale")
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="CancelListingForm">Cancel</button>
                    </div>
                </div>
            </div>
        }
    }
    }
}

@if (showRetireConfirm && rat is not null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.45)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Retire @rat.Name?</h5>
                    <button type="button" class="btn-close" @onclick="CloseRetireModal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">This is permanent. @rat.Name will be removed from gameplay and kept as a frozen record. This cannot be undone.</p>
                    @if (retireError is not null)
                    {
                        <div class="alert alert-danger py-2 mb-0 mt-3">@retireError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseRetireModal" disabled="@retireBusy">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmRetireAsync" disabled="@retireBusy">
                        @(retireBusy ? "Retiring..." : "Retire Rat")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (secretToastMessage is not null)
{
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index:1100">
        <div class="alert alert-success alert-dismissible shadow">
            @secretToastMessage
            <button type="button" class="btn-close" @onclick="() => secretToastMessage = null"></button>
        </div>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    RatResponse? rat;
    GameSettingsResponse? settings;
    string? secretToastMessage;
    bool renaming;
    string newName = "";
    bool training;
    string? trainMessage;
    bool trainSuccess;
    bool listingFormOpen;
    decimal listingPrice = 100;
    bool listingBusy;
    string? listingMessage;
    bool listingSuccess;
    bool showRetireConfirm;
    bool retireBusy;
    string? retireError;
    RatResponse[] maleRats = [];
