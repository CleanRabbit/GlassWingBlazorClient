@page "/rats/{Id}"
@inject GlassWingApiClient Api
@inject AuthStateService Auth
@inject NavigationManager Nav
@inject PlayerStateService PlayerState

<PageTitle>@(rat?.Name ?? "Rat") — GlassWing</PageTitle>

@if (rat is null)
{
    <p>Loading...</p>
}
else
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/rats">Rats</a></li>
            <li class="breadcrumb-item active">@rat.Name</li>
        </ol>
    </nav>

    @if (!rat.IsRetired && DaysUntilRetirement() is { } daysLeft)
    {
        @if (settings?.RetirementWarningLateDays is { } lateDays && daysLeft <= lateDays)
        {
            <div class="alert alert-danger py-2">@rat.Name retires in less than a day.</div>
        }
        else if (settings?.RetirementWarningEarlyDays is { } earlyDays && daysLeft <= earlyDays)
        {
            <div class="alert alert-warning py-2">@rat.Name will retire in about @Math.Ceiling(daysLeft) day@(Math.Ceiling(daysLeft) == 1 ? "" : "s").</div>
        }
    }

    <div class="d-flex align-items-center gap-3 mb-4">
        @if (rat.IsRetired)
        {
            <h1 class="mb-0">@rat.Name</h1>
            <span class="badge bg-dark">Retired</span>
            <span class="text-muted">@RetirementReasonLabel(rat.RetirementReason) @(rat.RetiredAt is { } ra ? $"· {ra:dd MMM yyyy}" : "")</span>
        }
        else if (!renaming)
        {
            <h1 class="mb-0">@rat.Name</h1>
            <span class="badge bg-info text-dark">@rat.LifeStage</span>
            @if (rat.IsNursing)
            {
                <span class="badge bg-warning text-dark" title="Nursing — locked to this cage; cannot train, breed, enter events, or be moved/sold/listed">🔒 Nursing</span>
            }
            else if (rat.IsProtective)
            {
                <span class="badge bg-warning text-dark" title="Protective mother — free-roam training unavailable too">🛡️ Protective</span>
            }
            @if (rat.LifeStage != "Weening")
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick="StartRename">Rename</button>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => showRetireConfirm = true">Retire</button>
            }
        }
        else
        {
            <input class="form-control w-auto" @bind="newName" />
            <button class="btn btn-sm btn-primary" @onclick="ConfirmRenameAsync">Save</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => renaming = false">Cancel</button>
        }
    </div>

    @if (rat.LifeStage == "Weening")
    {
        <div class="card" style="max-width:400px">
            <div class="card-body">
                <p class="mb-1">Born @rat.DateOfBirth.ToString("dd MMM yyyy")</p>
                @if (motherName is not null)
                {
                    <p class="mb-1">Mother: <a href="/rats/@rat.MotherId">@motherName</a></p>
                }
                <p class="text-muted small mb-0">
                    Too young to show full details. Check back once @rat.Name reaches the Infant stage.
                </p>
            </div>
        </div>
    }
    else
    {
    <div class="row g-3 mb-3">

        @* Ability *@
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="card-subtitle mb-3 text-muted">Ability</h6>
                    @foreach (var (label, ability, potential) in new[] {
                        ("Sprint", rat.SprintAbility, rat.SprintPotential),
                        ("Agility", rat.AgilityAbility, rat.AgilityPotential),
                        ("Endurance", rat.EnduranceAbility, rat.EndurancePotential) })
                    {
                        var pct = potential > 0 ? ability / potential * 100 : 0;
                        <div class="d-flex justify-content-between mb-1">
                            <span class="small text-muted">@label</span>
                            <span class="small">@ability.ToString("F1") / @potential</span>
                        </div>
                        <div class="progress mb-2" style="height:8px">
                            <div class="progress-bar bg-primary" style="width:@(pct.ToString("F0"))%"></div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Health *@
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="card-subtitle mb-3 text-muted">Health</h6>
                    @if (rat.HealthState is { } h)
                    {
                        <div class="mb-3">
                            <span class="badge @VitalityBadgeClass(h.Vitality) fs-6">@(h.Vitality ?? "Unknown")</span>
                        </div>
                        <table class="table table-sm mb-3">
                            <tbody>
                                <tr><th>Weight</th><td>@h.WeightGrams.ToString("F1")g</td></tr>
                                <tr><th>Length</th><td>@h.BodyLengthCm.ToString("F1")cm</td></tr>
                            </tbody>
                        </table>
                        @if (h.ActiveIllnesses is { Length: > 0 })
                        {
                            <h6 class="text-danger mb-2">Active Illnesses</h6>
                            @foreach (var illness in h.ActiveIllnesses)
                            {
                                <div class="border border-danger rounded p-2 mb-2 small">
                                    <div class="fw-bold">@illness.IllnessId</div>
                                    <div class="text-muted">Since @illness.StartedAt.ToString("dd MMM yyyy")</div>
                                    @if (illness.TreatmentApplied)
                                    {
                                        <span class="badge bg-success mt-1">Treatment applied</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark mt-1">Untreated</span>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <small class="text-muted">No active illnesses</small>
                        }
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </div>
            </div>
        </div>

        @* Tricks *@
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="card-subtitle mb-3 text-muted">Tricks</h6>
                    @if (rat.TricksLearned is { Length: > 0 })
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var trick in rat.TricksLearned)
                            {
                                <li>@trick</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted">None yet</span>
                    }
                </div>
            </div>
        </div>

    </div>

    @* Appearance *@
    @if (rat.Phenotype is { Coat: { } coat } phenotype)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h6 class="card-subtitle mb-3 text-muted">Appearance</h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <table class="table table-sm mb-0">
                            <tbody>
                                <tr>
                                    <th>Description</th>
                                    <td>@CoatDescription(coat)</td>
                                </tr>
                                <tr><th>Eyes</th><td>@(coat.EyeColor ?? "—")</td></tr>
                                <tr><th>Ears</th><td>@(coat.EarType ?? "—")</td></tr>
                                @if (coat.Pattern == "Hooded" && coat.HoodQuality is not null)
                                {
                                    <tr><th>Hood Quality</th><td>@coat.HoodQuality</td></tr>
                                }
                                @if (coat.PointColor is not null)
                                {
                                    <tr><th>Point Colour</th><td>@coat.PointColor</td></tr>
                                }
                                @if (phenotype.Morphology is { } morph)
                                {
                                    <tr><th>Sex</th><td>@(morph.Sex ?? "—")</td></tr>
                                    <tr><th>Size</th><td>@morph.BodySize / 100</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <p class="text-muted small mb-2">Markings</p>
                        <div class="d-flex flex-wrap gap-2">
                            @if (coat.HasBlaze)         { <span class="badge bg-secondary">Blaze</span> }
                            @if (coat.IsRoan)           { <span class="badge bg-secondary">Roan</span> }
                            @if (coat.IsDownunder)      { <span class="badge bg-secondary">Downunder</span> }
                            @if (coat.IsDownunderHomozygous) { <span class="badge bg-secondary">Downunder (HZ)</span> }
                            @if (coat.Silvering == "Light")  { <span class="badge bg-secondary">Light Silvering</span> }
                            @if (coat.Silvering == "Heavy")  { <span class="badge bg-secondary">Heavy Silvering</span> }
                            @if (!coat.HasBlaze && !coat.IsRoan && !coat.IsDownunder
                                 && coat.Silvering is null or "None")
                            {
                                <span class="text-muted small">None</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @* Training *@
    @if (!rat.IsRetired && rat.LifeStage != "Infant" && !rat.IsNursing)
    {
        <h5>Training</h5>
        <div class="d-flex gap-2 mb-2">
            <button class="btn btn-outline-primary" @onclick='() => TrainAsync("Sprint")' disabled="@training">Sprint</button>
            <button class="btn btn-outline-primary" @onclick='() => TrainAsync("Agility")' disabled="@training">Agility</button>
            <button class="btn btn-outline-primary" @onclick='() => TrainAsync("Endurance")' disabled="@training">Endurance</button>
        </div>
        @if (trainMessage is not null)
        {
            <div class="alert @(trainSuccess ? "alert-success" : "alert-warning") py-2">@trainMessage</div>
        }
    }

    @* Breeding *@
    @if (!rat.IsRetired && rat.LifeStage == "Adult" && !rat.IsNursing)
    {
        <h5 class="mt-4">Breeding</h5>
        @if (rat.Sex == "Male")
        {
            <p class="text-muted small">This rat can sire litters. Start breeding from the mother's page.</p>
        }
        else if (rat.IsPregnant)
        {
            <p class="mb-1">
                🐭 Pregnant — due @(rat.DueAt is { } due ? $"in {Math.Max(0, (due - DateTime.UtcNow).Days)} day{(Math.Max(0, (due - DateTime.UtcNow).Days) == 1 ? "" : "s")}" : "soon")
                @if (fatherName is not null)
                {
                    <text>(sired by @fatherName)</text>
                }
            </p>
        }
        else
        {
            <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
                <select class="form-select form-select-sm" style="max-width: 220px" @bind="selectedMateId">
                    <option value="">— pick a mate —</option>
                    @foreach (var m in maleRats)
                    {
                        <option value="@m.Id">@m.Name</option>
                    }
                </select>
                <button class="btn btn-outline-primary btn-sm" @onclick="BreedAsync" disabled="@(string.IsNullOrEmpty(selectedMateId) || breeding)">
                    @(breeding ? "Breeding..." : "Breed")
                </button>
            </div>
            @if (breedMessage is not null)
            {
                <div class="alert alert-danger py-2">@breedMessage</div>
            }
        }
    }

    @* Marketplace *@
    @if (!rat.IsRetired && !rat.IsNursing && rat.HealthState?.Vitality == "Healthy")
    {
        <h5 class="mt-4">Marketplace</h5>
        @if (!listingFormOpen)
        {
            <button class="btn btn-outline-secondary" @onclick="() => listingFormOpen = true">List on Marketplace</button>
        }
        else
        {
            <div class="card" style="max-width:400px">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Asking Price (cr)</label>
                        <input type="number" class="form-control" @bind="listingPrice" min="1" />
                    </div>
                    @if (settings?.MarketplaceListingFee is { } fee || settings?.MarketplaceTransactionFeePercent is { } txPct)
                    {
                        <div class="mb-3 small text-muted">
                            @if (settings.MarketplaceListingFee is { } f)
                            {
                                <div>Listing fee: @f.ToString("N0") cr (charged now)</div>
                            }
                            @if (settings.MarketplaceTransactionFeePercent is { } p)
                            {
                                <div>Transaction fee: @((p * 100).ToString("F0"))% deducted on sale</div>
                            }
                        </div>
                    }
                    @if (listingMessage is not null)
                    {
                        <div class="alert @(listingSuccess ? "alert-success" : "alert-danger") py-2">@listingMessage</div>
                    }
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary" @onclick="CreateListingAsync" disabled="@listingBusy">
                            @(listingBusy ? "Listing..." : "List for Sale")
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="CancelListingForm">Cancel</button>
                    </div>
                </div>
            </div>
        }
    }
    }
}

@if (showRetireConfirm && rat is not null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.45)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Retire @rat.Name?</h5>
                    <button type="button" class="btn-close" @onclick="CloseRetireModal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">This is permanent. @rat.Name will be removed from gameplay and kept as a frozen record. This cannot be undone.</p>
                    @if (retireError is not null)
                    {
                        <div class="alert alert-danger py-2 mb-0 mt-3">@retireError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseRetireModal" disabled="@retireBusy">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmRetireAsync" disabled="@retireBusy">
                        @(retireBusy ? "Retiring..." : "Retire Rat")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    RatResponse? rat;
    GameSettingsResponse? settings;
    bool renaming;
    string newName = "";
    bool training;
    string? trainMessage;
    bool trainSuccess;
    bool listingFormOpen;
    decimal listingPrice = 100;
    bool listingBusy;
    string? listingMessage;
    bool listingSuccess;
    bool showRetireConfirm;
    bool retireBusy;
    string? retireError;
    RatResponse[] maleRats = [];
    string selectedMateId = "";
    bool breeding;
    string? breedMessage;
    string? fatherName;
    string? motherName;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login"); return; }
        await Task.WhenAll(LoadRatAsync(), LoadSettingsAsync(), LoadMaleRatsAsync());
    }

    async Task LoadRatAsync()
    {
        rat = await Api.GetRatAsync(Id);
        newName = rat?.Name ?? "";
        if (rat is { IsPregnant: true, FatherId: { } fatherId })
            fatherName = (await Api.GetRatAsync(fatherId))?.Name ?? "another rat";
        if (rat is { LifeStage: "Weening", MotherId: { } motherId })
            motherName = (await Api.GetRatAsync(motherId))?.Name ?? "another rat";
    }

    async Task LoadMaleRatsAsync() =>
        maleRats = (await Api.ListRatsAsync() ?? [])
            .Where(r => r.Sex == "Male" && !r.IsRetired && r.Id != Id)
            .ToArray();

    async Task LoadSettingsAsync() => settings = await Api.GetGameSettingsAsync();

    void StartRename()
    {
        newName = rat?.Name ?? "";
        renaming = true;
    }

    async Task ConfirmRenameAsync()
    {
        if (string.IsNullOrWhiteSpace(newName)) return;
        var updated = await Api.RenameRatAsync(Id, newName);
        if (updated is not null) rat = updated;
        renaming = false;
    }

    async Task TrainAsync(string stat)
    {
        training = true;
        trainMessage = null;
        var (updated, error) = await Api.TrainRatAsync(Id, stat);
        if (updated is not null)
        {
            rat = updated;
            trainSuccess = true;
            trainMessage = $"Trained {stat}!";
        }
        else
        {
            trainSuccess = false;
            trainMessage = error ?? "Training failed.";
        }
        training = false;
    }

    async Task BreedAsync()
    {
        if (string.IsNullOrEmpty(selectedMateId)) return;
        breeding = true;
        breedMessage = null;
        var (result, error, reason) = await Api.BreedRatsAsync(Id, selectedMateId);
        if (result is not null)
        {
            await LoadRatAsync();
            selectedMateId = "";
        }
        else
        {
            breedMessage = BreedErrorMessage(reason) ?? error ?? "Failed to breed.";
        }
        breeding = false;
    }

    static string? BreedErrorMessage(string? reason) => reason switch
    {
        "WrongSexPairing"       => "One rat must be male and one female.",
        "FemaleRetired"         => "This rat has retired and can no longer breed.",
        "MaleRetired"           => "The selected mate has retired.",
        "AlreadyPregnant"       => "This rat is already pregnant.",
        "CooldownActive"        => "Still recovering from her last litter.",
        "LitterLimitReached"    => "This rat has reached her lifetime litter limit.",
        "FemaleNotAdult"        => "Must be fully grown to breed.",
        "FemaleTooYoung"        => "Outside the breeding age window.",
        "FemaleTooOld"          => "Outside the breeding age window.",
        "MaleTooOld"            => "The selected mate is too old to sire a litter.",
        "SexSeparationRequired" => "Separate the mixed-sex adults in your home before breeding.",
        _                       => null
    };

    void CancelListingForm()
    {
        listingFormOpen = false;
        listingMessage  = null;
    }

    void CloseRetireModal()
    {
        showRetireConfirm = false;
        retireError = null;
    }

    async Task ConfirmRetireAsync()
    {
        retireBusy = true;
        retireError = null;
        var (updated, error, _) = await Api.RetireRatAsync(Id);
        if (updated is not null)
        {
            rat = updated;
            showRetireConfirm = false;
        }
        else
        {
            retireError = error ?? "Failed to retire rat.";
        }
        retireBusy = false;
    }

    double? DaysUntilRetirement()
    {
        if (rat is null || rat.RetiresAt == default) return null;
        return (rat.RetiresAt - DateTime.UtcNow).TotalDays;
    }

    static string RetirementReasonLabel(string? reason) => reason switch
    {
        "NaturalAge"       => "Natural age",
        "PlayerInitiated"  => "Player choice",
        "CriticalHealth"   => "Critical health",
        _                  => ""
    };

    async Task CreateListingAsync()
    {
        if (listingPrice <= 0) { listingMessage = "Enter a valid price above 0."; listingSuccess = false; return; }
        listingBusy    = true;
        listingMessage = null;
        var (result, err) = await Api.CreateListingAsync(Id, listingPrice);
        if (result is not null)
        {
            PlayerState.SetCurrency(result.NewBalance);
            Nav.NavigateTo("/marketplace");
        }
        else
        {
            listingSuccess = false;
            listingMessage = err ?? "Failed to create listing.";
        }
        listingBusy = false;
    }

    static string VitalityBadgeClass(string? vitality) => vitality switch
    {
        "Healthy"  => "bg-success",
        "Stressed" => "bg-warning text-dark",
        "Pregnant" => "bg-info text-dark",
        "Ill"      => "bg-danger",
        "Critical" => "bg-danger",
        _          => "bg-secondary"
    };

    static string CoatDescription(CoatPhenotype c)
    {
        var parts = new System.Collections.Generic.List<string>();
        if (c.EarType is "Dumbo") parts.Add("Dumbo");
        if (c.BaseColor is not null) parts.Add(c.BaseColor);
        if (c.Pattern is not null) parts.Add(c.Pattern);
        if (c.Type is not null and not "Standard") parts.Add(c.Type);
        return parts.Count > 0 ? string.Join(" ", parts) : "—";
    }
}
