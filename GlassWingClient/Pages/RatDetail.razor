    static string? TrickTrainingErrorMessage(string? reason) => reason switch
    {
        "RatNotInCage"         => "Rat must be in a cage to train.",
        "RatRetired"           => "Retired rats cannot train tricks.",
        "AlreadyLearned"       => "Already learned.",
        "InsufficientAptitude" => "This rat isn't ready for that trick yet.",
        _                      => null
    };

    double UsedProgress() =>
        Math.Max(0, (settings?.MaxActiveProgressPerRatPerDay ?? 0) - (rat?.PlaySession?.DailyProgressRemaining ?? 0));

    string FormatElapsed() => TimeSpan.FromSeconds(elapsedSeconds).ToString(@"mm\:ss");

    void StartPlaySession()
    {
        playSessionStartedAt = DateTime.UtcNow;
        elapsedSeconds = 0;
        playSessionActive = true;
        playSessionMessage = null;
        var cap = settings?.MaxPlaySessionSeconds ?? 600;
        playTimer = new System.Threading.Timer(_ =>
        {
            var real = (int)(DateTime.UtcNow - playSessionStartedAt!.Value).TotalSeconds;
            elapsedSeconds = Math.Min(real, cap);
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    async Task EndPlaySessionAsync()
    {
        if (elapsedSeconds == 0 || rat?.CurrentTrickTraining is not { } training) return;
        playTimer?.Dispose();
        playTimer = null;
        playSessionActive = false;
        playSessionBusy = true;

        var (result, error, reason) = await Api.SubmitPlaySessionAsync(Id, training.TrickId, elapsedSeconds);
        if (result is not null)
        {
            playSessionSuccess = true;
            playSessionMessage = result.CappedByDailyLimit
                ? "Come back tomorrow for full training benefit — today's active limit is reached, but bonding still grew."
                : $"+{result.ProgressGained:F1} progress, +{(result.BondingAfter - result.BondingBefore):F1} bonding";
            if (result.TrickLearned) playSessionMessage += " — trick learned!";

            var awardedCurrency = false;
            foreach (var a in result.NewAchievements)
            {
                var toasted = RewardToasts.TryEnqueueAchievement(a.Id, new RewardToastItem(
                    RewardToastKind.Achievement, "Achievement Unlocked!", a.Name, a.Currency, a.TitleId, a.CosmeticId));
                if (toasted && a.Currency.HasValue) awardedCurrency = true;
            }
            if (awardedCurrency)
            {
                var profile = await Api.GetPlayerProfileAsync();
                if (profile is not null) PlayerState.SetCurrency(profile.Currency);
            }

            await LoadRatAsync();
        }
        else
        {
            playSessionSuccess = false;
            playSessionMessage = PlaySessionErrorMessage(reason) ?? error ?? "Failed to submit play session.";
        }
        elapsedSeconds = 0;
        playSessionBusy = false;
    }

    static string? PlaySessionErrorMessage(string? reason) => reason switch
    {
        "RatRetired"    => "Retired rats cannot play.",
        "RatNotInCage"  => "Rat must be in a cage to play.",
        "NotInTraining" => "Assign a trick before starting a play session.",
        _               => null
    };

    public void Dispose() => playTimer?.Dispose();

    async Task LoadRatAsync()
    {
        rat = await Api.GetRatAsync(Id);
        isPublicView = false;
        if (rat is null)
        {
            // Not found, or not owned by the caller — RatsModule.GetRatAsync 404s in both
            // cases. Fall back to the public projection before giving up entirely.
            var pub = await Api.GetPublicRatAsync(Id);
            if (pub is not null)
            {
                isPublicView = true;
                rat = new RatResponse(
                    Id: pub.Id,
                    Name: pub.Name,
                    OwnerId: pub.OwnerId,
                    HealthState: null,
                    Phenotype: pub.Phenotype,
                    TricksLearned: pub.TricksLearned,
                    IsRetired: pub.IsRetired,
                    RetiredAt: pub.RetiredAt,
                    RetirementReason: pub.RetirementReason,
                    RetiresAt: pub.RetiresAt,
                    Sex: pub.Sex,
                    LifeStage: pub.LifeStage,
                    MotherId: pub.MotherId,
                    FatherId: pub.FatherId,
                    SprintAbility: pub.SprintAbility,
                    AgilityAbility: pub.AgilityAbility,
                    EnduranceAbility: pub.EnduranceAbility,
                    SprintPotential: pub.SprintPotential,
                    AgilityPotential: pub.AgilityPotential,
                    EndurancePotential: pub.EndurancePotential,
                    DateOfBirth: pub.DateOfBirth,
                    ActiveCosmeticId: pub.ActiveCosmeticId,
                    Traits: pub.Traits,
                    Ancestry: pub.Ancestry);
            }
        }
        newName = rat?.Name ?? "";
        if (rat is { IsPregnant: true, FatherId: { } fatherId })
            fatherName = (await Api.GetRatAsync(fatherId))?.Name ?? "another rat";
        if (rat is { LifeStage: "Weening", MotherId: { } motherId })
            motherName = (await Api.GetRatAsync(motherId))?.Name ?? "another rat";
    }

    async Task LoadMaleRatsAsync() =>
        maleRats = (await Api.ListRatsAsync() ?? [])
            .Where(r => r.Sex == "Male" && !r.IsRetired && r.Id != Id)
            .ToArray();

    async Task LoadSettingsAsync() => settings = await Api.GetGameSettingsAsync();

