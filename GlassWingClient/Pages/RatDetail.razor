    async Task ConfirmTrickTrainingAsync()
    {
        trickBusy = true;
        trickError = null;
        var trickId = string.IsNullOrEmpty(trickPickerValue) ? null : trickPickerValue;
        var (updated, error, reason) = await Api.SetTrickTrainingAsync(Id, trickId);
        if (updated is not null)
        {
            rat = updated;
            trickPickerOpen = false;
            await LoadTrickCatalogueAsync();
        }
        else
        {
            trickError = TrickTrainingErrorMessage(reason) ?? error ?? "Failed to update training.";
        }
