    static string CoatDescription(CoatPhenotype c)
    {
        var parts = new System.Collections.Generic.List<string>();
        if (c.EarType is "Dumbo") parts.Add("Dumbo");
        if (c.BaseColor is not null) parts.Add(c.BaseColor);
        if (c.Pattern is not null) parts.Add(c.Pattern);
        if (c.Type is not null and not "Standard") parts.Add(c.Type);
        return parts.Count > 0 ? string.Join(" ", parts) : "—";
    }

    // Ancestry (Task 13). depth 1 = parent, 2 = grandparent, 3 = great-grandparent,
    // 4 = great-great-grandparent (the API bounds the tree at 4 generations). Generations 1-2
    // render unconditionally; the depth-2 -> depth-3 transition is the single "show more
    // ancestors" toggle per branch — once expanded, depth 3 -> 4 auto-renders too (one toggle
    // reveals both remaining generations, not one toggle per level).
    void ToggleAncestorBranch(string key)
    {
        if (!expandedAncestorBranches.Add(key)) expandedAncestorBranches.Remove(key);
    }

    RenderFragment AncestorNodeView(AncestorNode? node, string branchKey, int depth) => __builder =>
    {
        if (node is null)
        {
            <span class="text-muted small">— unknown —</span>
            return;
        }

        <div class="border rounded p-2 mb-1" style="min-width:200px">
            <div class="fw-semibold small">
                @node.Name @(node.Sex == "Male" ? "♂" : "♀")
                @if (node.IsEnriched)
                {
                    <span class="badge bg-dark ms-1">Retired@(node.RetirementReason is not null ? $" — {RetirementReasonLabel(node.RetirementReason)}" : "")</span>
                }
            </div>

            @if (!node.IsEnriched)
            {
                <a href="/rats/@node.RatId" class="small">Live — view</a>
            }
            else
            {
                @if (node.DateOfBirth is { } dob)
                {
                    <div class="text-muted small">Born @dob.ToString("dd MMM yyyy")</div>
                }
                @if (node.SprintAbility is not null)
                {
                    <div class="text-muted small">
                        Spr @node.SprintAbility?.ToString("F1")/@node.SprintPotential
                        · Agi @node.AgilityAbility?.ToString("F1")/@node.AgilityPotential
                        · End @node.EnduranceAbility?.ToString("F1")/@node.EndurancePotential
                    </div>
                }
                @if (node.Coat is { } coat)
                {
                    <div class="text-muted small">@AncestorCoatDescription(coat)</div>
                }
            }

            @if (node.Father is not null || node.Mother is not null)
            {
                var autoExpand = depth != 2 || expandedAncestorBranches.Contains(branchKey);
                @if (autoExpand)
                {
                    <div class="mt-2 ps-2 border-start d-flex gap-2">
                        @AncestorNodeView(node.Father, branchKey + "f", depth + 1)
                        @AncestorNodeView(node.Mother, branchKey + "m", depth + 1)
                    </div>
                }
                else
                {
                    <button class="btn btn-link btn-sm p-0 mt-1" @onclick="() => ToggleAncestorBranch(branchKey)">
                        Show more ancestors
                    </button>
                }
            }
        </div>
    };

    static string AncestorCoatDescription(CoatSnapshot c)
    {
        var desc = c.Pattern is not "Self" ? $"{c.Colour} {c.Pattern}" : c.Colour;
        var markers = new System.Collections.Generic.List<string>();
        if (c.HasBlaze) markers.Add("Blaze");
        if (c.IsRoan) markers.Add("Roan");
        if (c.IsDownunder) markers.Add("Downunder");
        if (c.Silvering is "Light") markers.Add("Light Silvering");
        if (c.Silvering is "Heavy") markers.Add("Heavy Silvering");
        return markers.Count > 0 ? $"{desc} ({string.Join(", ", markers)})" : desc;
    }
}
