    async Task VetVisitAsync()
    {
        vetBusy = true;
        vetMessage = null;
        var (result, error) = await Api.VetVisitAsync(Id);
        if (result is not null)
        {
            PlayerState.SetCurrency(result.NewBalance);
            vetSuccess = true;
            vetMessage = result.Diagnoses.Length == 1
                ? $"Diagnosed: {result.Diagnoses[0].Name}."
                : $"Diagnosed {result.Diagnoses.Length} illnesses: {string.Join(", ", result.Diagnoses.Select(d => d.Name))}.";
