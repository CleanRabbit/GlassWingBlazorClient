    async Task SetRatCosmeticAsync(string? cosmeticId)
    {
        cosmeticBusy = true;
        cosmeticError = null;
        var (success, err) = await Api.SetRatCosmeticAsync(Id, string.IsNullOrEmpty(cosmeticId) ? null : cosmeticId);
