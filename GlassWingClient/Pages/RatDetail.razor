    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login"); return; }
        await Task.WhenAll(LoadRatAsync(), LoadSettingsAsync(), LoadMaleRatsAsync(), LoadCosmeticsAsync(), LoadTrickCatalogueAsync(), LoadHomeAsync(), LoadShopCatalogueAsync());
        loaded = true;
    }

