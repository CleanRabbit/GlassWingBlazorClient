@page "/inventory"
@inject GlassWingApiClient Api
@inject AuthStateService Auth
@inject NavigationManager Nav

<PageTitle>Inventory — GlassWing</PageTitle>

<h1 class="mb-4">Inventory</h1>

@if (!loaded)
{
    <p class="text-muted">Loading...</p>
}
else if (inventory is null)
{
    <div class="alert alert-danger">Failed to load inventory.</div>
}
else if (inventory.Items.Length == 0)
{
    <p class="text-muted">Your inventory is empty. <a href="/shop">Visit the shop</a> to buy items.</p>
}
else
{
    @if (success is not null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @success
            <button type="button" class="btn-close" @onclick="() => success = null"></button>
        </div>
    }
    @if (error is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @error
            <button type="button" class="btn-close" @onclick="() => error = null"></button>
        </div>
    }

    <div class="row g-3">
        @foreach (var item in inventory.Items)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <h5 class="card-title mb-0">@item.Name</h5>
                            <span class="badge bg-secondary">@ItemTypeLabel(item.ItemType)</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <p class="text-muted small mb-2">@item.Description</p>
                        }
                        @if (item.Quantity > 1)
                        {
                            <p class="small mb-2"><span class="text-muted">Qty</span> @item.Quantity</p>
                        }

                        @if (placePanelItemId == item.Id)
                        {
                            <div class="border rounded p-2 mt-2 bg-light">
                                @if (home is null)
                                {
                                    <p class="text-muted small mb-0">Loading cages...</p>
                                }
                                else if (home.Cages.Length == 0)
                                {
                                    <p class="text-muted small mb-1">No cages available. Buy one from the <a href="/shop/cages">shop</a>.</p>
                                    <button class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => placePanelItemId = null">
                                        Cancel
                                    </button>
                                }
                                else
                                {
                                    <label class="form-label small">Place in cage</label>
                                    <select class="form-select form-select-sm mb-2" @bind="selectedCageId">
                                        <option value="">— select cage —</option>
                                        @foreach (var cage in home.Cages)
                                        {
                                            <option value="@cage.Id">@cage.Name</option>
                                        }
                                    </select>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-sm btn-primary"
                                                @onclick="() => ConfirmPlaceAsync(item.Id)"
                                                disabled="@(busy || string.IsNullOrEmpty(selectedCageId))">
                                            Place
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary"
                                                @onclick="() => placePanelItemId = null">
                                            Cancel
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-primary mt-auto"
                                    @onclick="() => OpenPlacePanelAsync(item.Id)"
                                    disabled="@busy">
                                Place in cage
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    InventoryResponse? inventory;
    HomeResponse? home;
    bool loaded;
    bool busy;
    string? success;
    string? error;
    string? placePanelItemId;
    string? selectedCageId;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login"); return; }
        inventory = await Api.GetInventoryAsync();
        loaded = true;
    }

    async Task OpenPlacePanelAsync(string itemId)
    {
        placePanelItemId = itemId;
        selectedCageId = null;
        if (home is null)
        {
            var (data, _) = await Api.GetHomeAsync();
            home = data;
        }
    }

    async Task ConfirmPlaceAsync(string itemId)
    {
        if (string.IsNullOrEmpty(selectedCageId)) return;
        busy = true; error = null; success = null;
        var (result, err) = await Api.PlaceInventoryItemAsync(itemId, selectedCageId);
        if (result?.Success == true)
        {
            success = "Item placed in cage!";
            placePanelItemId = null;
            inventory = await Api.GetInventoryAsync();
        }
        else error = err ?? result?.Message ?? "Failed to place item.";
        busy = false;
    }

    static string ItemTypeLabel(string itemType) => itemType switch
    {
        "Accessory"   => "Accessory",
        "FoodBowl"    => "Food Bowl",
        "WaterBottle" => "Water Bottle",
        _             => itemType
    };
}
