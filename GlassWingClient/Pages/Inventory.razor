@page "/inventory"
@inject GlassWingApiClient Api
@inject AuthStateService Auth
@inject NavigationManager Nav

<PageTitle>Inventory — GlassWing</PageTitle>
<h1 class="mb-4">Inventory</h1>

@if (!loaded)
{
    <p class="text-muted">Loading...</p>
}
else if (home is null)
{
    <div class="alert alert-danger">Failed to load home data.</div>
}
else
{
    @if (actionSuccess is not null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @actionSuccess
            <button type="button" class="btn-close" @onclick="() => actionSuccess = null"></button>
        </div>
    }
    @if (actionError is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @actionError
            <button type="button" class="btn-close" @onclick="() => actionError = null"></button>
        </div>
    }

    <!-- Carry Cases -->
    <h4 class="mb-3">Carry Cases</h4>
    @if ((home.CarryCases ?? []).Length == 0)
    {
        <p class="text-muted small mb-4">No carry cases. <a href="/shop/home-accessories">Buy one from the shop</a>.</p>
    }
    else
    {
        <div class="row g-3 mb-4">
            @foreach (var cc in home.CarryCases ?? [])
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center py-2">
                            <span class="fw-semibold">Carry Case</span>
                        </div>
                        <div class="card-body d-flex flex-column">
                            @if (cc.RatId is null)
                            {
                                <span class="text-muted small">Empty</span>
                            }
                            else
                            {
                                var ratName = ratNames.TryGetValue(cc.RatId, out var n) ? n : cc.RatId;
                                <p class="mb-2 small"><span class="text-muted">Rat</span> <strong class="ms-1">@ratName</strong></p>
                                @if (activePanelId == cc.Id && panelIsCarryCase)
                                {
                                    <div class="border rounded p-2 bg-light">
                                        @if (home.Cages.Length == 0)
                                        {
                                            <p class="text-muted small mb-1">No cages available. <a href="/shop/cages">Buy one</a>.</p>
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="ClosePanel">Cancel</button>
                                        }
                                        else
                                        {
                                            <label class="form-label small">Place in cage</label>
                                            <select class="form-select form-select-sm mb-2" @bind="selectedCageId">
                                                <option value="">— select cage —</option>
                                                @foreach (var cage in home.Cages)
                                                {
                                                    <option value="@cage.Id">@cage.Name</option>
                                                }
                                            </select>
                                            <div class="d-flex gap-2">
                                                <button class="btn btn-sm btn-primary"
                                                        disabled="@(busy || string.IsNullOrEmpty(selectedCageId))"
                                                        @onclick="ConfirmPlaceRatAsync">
                                                    Place
                                                </button>
                                                <button class="btn btn-sm btn-outline-secondary" @onclick="ClosePanel">Cancel</button>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-primary mt-auto"
                                            disabled="@busy"
                                            @onclick="() => OpenCarryCasePanel(cc.Id)">
                                        Place in cage
                                    </button>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Storage Drawers -->
    <h4 class="mb-3">Storage Drawers</h4>
    @if ((home.StorageDrawers ?? []).Length == 0)
    {
        <p class="text-muted small mb-4">No storage drawers. <a href="/shop/home-accessories">Buy one from the shop</a>.</p>
    }
    else
    {
        <div class="row g-3 mb-4">
            @foreach (var drawer in home.StorageDrawers ?? [])
            {
                var used = drawer.Capacity - drawer.SlotsAvailable;
                <div class="col-md-6 col-xl-4">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center py-2">
                            <span class="fw-semibold">Storage Drawers</span>
                            <span class="badge bg-secondary">@used / @drawer.Capacity slots used</span>
                        </div>
                        <div class="card-body">
                            @if (drawer.Items.Length == 0)
                            {
                                <p class="text-muted small">Empty</p>
                            }
                            else
                            {
                                @foreach (var item in drawer.Items)
                                {
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div>
                                            <span class="small fw-semibold">@KindLabel(item.Kind)</span>
                                            <span class="badge bg-light text-dark border ms-1 small">@item.TypeId</span>
                                        </div>
                                        @if (item.Kind == "Medication")
                                        {
                                            <span class="text-muted small">Administer from a rat's Health page</span>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-primary"
                                                    disabled="@(busy || (activePanelId == item.Id && !panelIsCarryCase))"
                                                    @onclick="() => OpenDrawerItemPanel(item.Id, item.Kind)">
                                                Install
                                            </button>
                                        }
                                    </div>
                                    @if (activePanelId == item.Id && !panelIsCarryCase)
                                    {
                                        <div class="border rounded p-2 mb-2 bg-light">
                                            @if (home.Cages.Length == 0)
                                            {
                                                <p class="text-muted small mb-1">No cages available. <a href="/shop/cages">Buy one</a>.</p>
                                                <button class="btn btn-sm btn-outline-secondary" @onclick="ClosePanel">Cancel</button>
                                            }
                                            else
                                            {
                                                <label class="form-label small">Install in cage</label>
                                                <select class="form-select form-select-sm mb-2" @bind="selectedCageId">
                                                    <option value="">— select cage —</option>
                                                    @foreach (var cage in home.Cages)
                                                    {
                                                        <option value="@cage.Id">@cage.Name</option>
                                                    }
                                                </select>
                                                <div class="d-flex gap-2">
                                                    <button class="btn btn-sm btn-primary"
                                                            disabled="@(busy || string.IsNullOrEmpty(selectedCageId))"
                                                            @onclick="ConfirmInstallItemAsync">
                                                        Install
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-secondary" @onclick="ClosePanel">Cancel</button>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Medication Devices -->
    <h4 class="mb-3">Medication Devices</h4>
    @if ((home.MedicationDevices ?? []).Length == 0)
    {
        <p class="text-muted small mb-4">No medication devices. <a href="/shop/medications">Buy one from the shop</a>.</p>
    }
    else
    {
        <div class="row g-3 mb-4">
            @foreach (var dev in home.MedicationDevices ?? [])
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card h-100">
                        <div class="card-header py-2">
                            <span class="fw-semibold">Medication Device</span>
                        </div>
                        <div class="card-body">
                            <span class="badge bg-light text-dark border small">@dev.TypeId</span>
                            <p class="text-muted small mb-0 mt-2">Use from a rat's Health page.</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Food Storage -->
    <h4 class="mb-3">Food Storage</h4>
    @if ((home.FoodStorageBins ?? []).Length == 0)
    {
        <p class="text-muted small mb-4">No food storage bins. <a href="/shop/food-bins">Buy one from the shop</a>.</p>
    }
    else
    {
        <div class="row g-3 mb-4">
            @foreach (var bin in home.FoodStorageBins ?? [])
            {
                var pct = bin.CapacityRatDays > 0 ? bin.StoredRatDays / bin.CapacityRatDays * 100 : 0;
                var barClass = pct < 25 ? "bg-danger" : pct < 60 ? "bg-warning" : "bg-success";
                <div class="col-md-6 col-xl-4">
                    <div class="card h-100">
                        <div class="card-header py-2">
                            <span class="fw-semibold">Food Storage Bin</span>
                        </div>
                        <div class="card-body">
                            <p class="small text-muted mb-1">@bin.StoredRatDays.ToString("F0") / @bin.CapacityRatDays rat-days stored</p>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar @barClass" style="width: @(pct.ToString("F0"))%"></div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    HomeResponse? home;
    Dictionary<string, string> ratNames = new();
    bool loaded;
    bool busy;
    string? actionError;
    string? actionSuccess;

    string? activePanelId;
    bool panelIsCarryCase;
    string? activeItemKind;
    string? selectedCageId;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login"); return; }
        await LoadAsync();
        loaded = true;
    }

    async Task LoadAsync()
    {
        var homeTask = Api.GetHomeAsync();
        var ratsTask = Api.ListRatsAsync();
        home = (await homeTask).Item1;
        ratNames = (await ratsTask)?.ToDictionary(r => r.Id, r => r.Name) ?? new();
    }

    void OpenCarryCasePanel(string carryCaseId)
    {
        activePanelId = carryCaseId;
        panelIsCarryCase = true;
        activeItemKind = null;
        selectedCageId = null;
        actionError = null;
        actionSuccess = null;
    }

    void OpenDrawerItemPanel(string itemId, string kind)
    {
        activePanelId = itemId;
        panelIsCarryCase = false;
        activeItemKind = kind;
        selectedCageId = null;
        actionError = null;
        actionSuccess = null;
    }

    void ClosePanel()
    {
        activePanelId = null;
        selectedCageId = null;
        activeItemKind = null;
    }

    async Task ConfirmPlaceRatAsync()
    {
        if (string.IsNullOrEmpty(selectedCageId) || activePanelId is null) return;
        busy = true; actionError = null; actionSuccess = null;
        var (success, err) = await Api.PlaceRatFromCarryCaseAsync(activePanelId, selectedCageId);
        ClosePanel();
        if (success)
        {
            actionSuccess = "Rat placed in cage.";
            await LoadAsync();
        }
        else
        {
            actionError = err ?? "Failed to place rat.";
        }
        busy = false;
    }

    async Task ConfirmInstallItemAsync()
    {
        if (string.IsNullOrEmpty(selectedCageId) || activePanelId is null || activeItemKind is null) return;
        busy = true; actionError = null; actionSuccess = null;

        bool success;
        string? err;
        if (activeItemKind == "FoodBowl")
            (success, err) = await Api.InstallBowlFromDrawerAsync(selectedCageId, activePanelId);
        else if (activeItemKind == "WaterBottle")
            (success, err) = await Api.InstallBottleFromDrawerAsync(selectedCageId, activePanelId);
        else if (activeItemKind == "Accessory")
            (success, err) = await Api.InstallAccessoryFromDrawerAsync(selectedCageId, activePanelId);
        else
            (success, err) = (false, "Unknown item type.");

        ClosePanel();
        if (success)
        {
            actionSuccess = "Item installed in cage.";
            await LoadAsync();
        }
        else
        {
            actionError = err ?? "Failed to install item.";
        }
        busy = false;
    }

    static string KindLabel(string kind) => kind switch
    {
        "FoodBowl"    => "Food Bowl",
        "WaterBottle" => "Water Bottle",
        "Accessory"   => "Accessory",
        "Medication"  => "Medication",
        _             => kind
    };
}
