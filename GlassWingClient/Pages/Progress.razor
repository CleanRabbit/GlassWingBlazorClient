@page "/progress"
@implements IDisposable
@inject AuthStateService Auth
@inject NavigationManager Nav
@inject ProgressStateService ProgressState

<PageTitle>Progress — GlassWing</PageTitle>

<h1 class="mb-4">Progress</h1>

<div class="row g-3">
    @foreach (var tile in Tiles)
    {
        <div class="col-sm-6 col-lg-4">
            @if (tile.Enabled)
            {
                <a href="@tile.Route" class="text-decoration-none">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body py-4">
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="card-title">@tile.Name</h5>
                                @if (tile.HasPending())
                                {
                                    <span class="badge bg-danger rounded-pill">New</span>
                                }
                            </div>
                            <p class="card-text text-muted small mb-0">@tile.Description</p>
                        </div>
                    </div>
                </a>
            }
            else
            {
                <div class="card h-100 border-0 shadow-sm opacity-50">
                    <div class="card-body py-4">
                        <h5 class="card-title">@tile.Name</h5>
                        <p class="card-text text-muted small mb-0">@tile.Description</p>
                        <span class="badge bg-secondary mt-2">Coming soon</span>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    record ProgressTile(string Route, string Name, string Description, bool Enabled, Func<bool> HasPending);

    ProgressTile[] Tiles = [];

    protected override void OnInitialized()
    {
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login"); return; }

        Tiles =
        [
            new("/progress/achievements", "Achievements",  "Milestones across breeding, competition, and care", true,  () => ProgressState.HasPendingAchievements),
            new("/progress/titles",       "Titles",        "Display titles earned from achievements",           true,  () => false),
            new("/progress/daily",        "Daily Reward",  "Claim today's login reward",                        true,  () => ProgressState.DailyRewardAvailable),
            new("/progress/challenges",   "Challenges",    "This week's rotating challenge set",                true,  () => ProgressState.HasPendingChallenges),
            new("/progress/seasonal",     "Seasonal Event","The current seasonal event's challenge track",      true,  () => ProgressState.HasPendingSeasonalCompletion),
            new("/progress/cosmetics",    "Cosmetics",     "Cage decorations and rat accessories",              false, () => false),
        ];

        ProgressState.OnChange += StateHasChanged;
    }

    public void Dispose() => ProgressState.OnChange -= StateHasChanged;
}
